# Copia este archivo como .env y ajusta lo que haga falta.

# Con Docker (docker compose up -d) los datos ya son estos:
DATABASE_URL=postgresql+psycopg://ecn:ecn@localhost:5432/elchiconaturista

# Con un PostgreSQL ya instalado en la máquina, usa tu usuario y clave:
# DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/elchiconaturista

ENTORNO=desarrollo
