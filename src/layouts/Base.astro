---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarritoPanel from '../components/CarritoPanel.astro';
import { tienda, waLink } from '../data/tienda.js';

const {
  title,
  description = 'Tienda de productos naturales en Lima: henna, suplementos, aceites esenciales y superalimentos peruanos. Pedidos por WhatsApp.',
  activo = '',
} = Astro.props;

const titulo = title ? `${title} · ${tienda.nombre}` : `${tienda.nombre} · ${tienda.lema}`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#2F5D50" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..700,0..100,0..1;1,9..144,400..700,0..100,0..1&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header activo={activo} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <CarritoPanel />

    <a
      class="wa-flotante"
      href={waLink('Hola, quiero hacer una consulta sobre sus productos.')}
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.02c-.24.68-1.42 1.32-1.95 1.36-.5.05-.98.24-3.3-.69-2.79-1.1-4.56-3.96-4.7-4.15-.14-.19-1.12-1.49-1.12-2.84s.71-2.02.96-2.29c.25-.27.55-.34.73-.34.18 0 .37 0 .53.01.17.01.4-.06.62.48.24.57.8 1.97.87 2.11.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.17.28.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.29 1.41.28.14.45.12.62-.07.17-.19.71-.83.9-1.12.19-.28.38-.23.63-.14.25.09 1.65.78 1.93.92.28.14.47.21.54.33.07.11.07.65-.17 1.33Z"
        ></path>
      </svg>
    </a>

    <style>
      .saltar {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: var(--salvia);
        color: #fff;
        padding: 0.7rem 1.1rem;
      }

      .saltar:focus {
        left: 0;
      }

      .wa-flotante {
        position: fixed;
        right: 1.4rem;
        bottom: 1.4rem;
        z-index: 70;
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        background: #1f7a4d;
        color: #fff;
        border-radius: 50%;
        box-shadow: 0 10px 22px -12px rgba(31, 122, 77, 0.9);
        transition: transform 0.2s;
      }

      .wa-flotante:hover {
        transform: translateY(-2px);
      }

      @media (max-width: 560px) {
        .wa-flotante {
          width: 48px;
          height: 48px;
          right: 1rem;
          bottom: 1rem;
        }
      }
    </style>
  </body>
</html>
