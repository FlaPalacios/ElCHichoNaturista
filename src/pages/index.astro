---
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard.astro';
import ApiCaida from '../components/ApiCaida.astro';
import Greca from '../components/Greca.astro';
import { obtenerCategorias, obtenerProductos } from '../lib/api.js';
import { waLink as enlaceWa } from '../lib/tienda.js';

// Los datos de la tienda los carga el middleware desde la API.
const tienda = Astro.locals.tienda;
const waLink = (mensaje) => enlaceWa(tienda, mensaje);

// Una sola llamada trae el catálogo y de ahí salen todas las secciones:
// es más rápido que pedirle a la API una lista por bloque.
let productos = [];
let categorias = [];
let fallo = null;
try {
  [productos, categorias] = await Promise.all([obtenerProductos(), obtenerCategorias()]);
} catch (error) {
  fallo = error;
}

// Cada bloque sale de las marcas del catálogo y solo se muestra si tiene
// productos. El último junta lo que no entró en ninguno, así la portada
// nunca queda vacía.
const enBloque = new Set();
const tomar = (lista) => {
  lista.forEach((p) => enBloque.add(p.id));
  return lista.slice(0, 8);
};
const bloques = [
  { titulo: 'Destacados', enlace: '/catalogo', productos: tomar(productos.filter((p) => p.destacado)) },
  { titulo: 'Los más vendidos', enlace: '/catalogo?orden=vendidos', productos: tomar(productos.filter((p) => p.masVendido)) },
  { titulo: 'En oferta', enlace: '/catalogo', productos: tomar(productos.filter((p) => p.precioAntes)) },
  { titulo: 'Del catálogo', enlace: '/catalogo', productos: productos.filter((p) => !enBloque.has(p.id)).slice(0, 8) },
].filter((b) => b.productos.length > 0);

const cuantosEn = (slug) => productos.filter((p) => p.categoria === slug).length;

const beneficios = [
  { t: 'Envíos a todo el Perú', d: 'Delivery el mismo día en Lima' },
  { t: 'Envío gratis', d: `En todo el Perú desde S/ ${tienda.envioGratisDesde}` },
  { t: 'Pedido por WhatsApp', d: 'Sin pasarela de pago' },
  { t: 'Marcas de confianza', d: 'Green House, HIRI y Henna Colors' },
];
---

<Base activo="inicio">
  {fallo && <ApiCaida error={fallo} />}
  {!fallo && (
  <>
  <!-- ── Banner ──────────────────────────────────────────────── -->
  <!-- Carrusel de 3 fotos; de momento las 3 son la misma imagen. -->
  <section
    class="banner"
    x-data={`{
      slide: 0, n: 3, auto: null,
      ir(k) { this.slide = (k + this.n) % this.n; this.reiniciar() },
      reiniciar() { clearInterval(this.auto); this.auto = setInterval(() => this.slide = (this.slide + 1) % this.n, 6000) }
    }`}
    x-init="reiniciar()"
    @mouseenter="clearInterval(auto)"
    @mouseleave="reiniciar()"
    aria-roledescription="carrusel"
    aria-label="Fotos de productos naturales"
  >
    {
      [0, 1, 2].map((i) => (
        <picture class="banner__foto" x-show={`slide === ${i}`} x-transition.opacity.duration.500ms>
          <source type="image/webp" media="(max-width: 700px)" srcset="/hero-760.webp" />
          <source type="image/webp" media="(max-width: 1200px)" srcset="/hero-1200.webp" />
          <source type="image/webp" srcset="/hero-1672.webp" />
          <img
            src="/hero.jpg"
            alt="Mesa con productos naturales: tintes de henna, cápsulas, aceites esenciales y superalimentos"
            width="1672"
            height="941"
            fetchpriority={i === 0 ? 'high' : 'low'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </picture>
      ))
    }

    <div class="banner__velo"></div>

    <div class="banner__control">
      <button @click="ir(slide - 1)" aria-label="Foto anterior">←</button>
      <div class="banner__puntos">
        {
          [0, 1, 2].map((i) => (
            <button @click={`ir(${i})`} :class={`slide === ${i} && 'es-actual'`} aria-label={`Ir a la foto ${i + 1}`} />
          ))
        }
      </div>
      <button @click="ir(slide + 1)" aria-label="Foto siguiente">→</button>
    </div>

    <div class="env banner__env">
      <div class="banner__texto">
        <p class="banner__kicker">Tienda de productos naturales · Lima</p>
        <h1 class="banner__titulo">Henna, aceites,<br />superalimentos y kéfir</h1>
        <p class="banner__plomo">
          {productos.length} productos de marcas peruanas. Pides por aquí, lo cerramos por WhatsApp.
        </p>
        <div class="banner__acciones">
          <a href="/catalogo" class="btn">Ver el catálogo</a>
          <a
            href={waLink('Hola, quiero hacer un pedido.')}
            target="_blank"
            rel="noopener"
            class="btn btn--wa">Pedir por WhatsApp</a
          >
        </div>
      </div>
    </div>
  </section>

  <Greca />

  <!-- ── Beneficios ──────────────────────────────────────────── -->
  <section class="beneficios">
    <div class="env beneficios__env">
      {
        beneficios.map((b) => (
          <div class="beneficio">
            <p class="beneficio__t">{b.t}</p>
            <p class="beneficio__d">{b.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Departamentos ───────────────────────────────────────── -->
  <nav class="env deptos" aria-label="Departamentos">
    {
      categorias.map((c) => (
        <a href={`/catalogo?categoria=${c.slug}`} class="depto">
          <span class="depto__nombre">{c.nombre}</span>
          <span class="depto__cuenta">{cuantosEn(c.slug)} productos</span>
        </a>
      ))
    }
  </nav>

  <!-- ── Bloques de producto ─────────────────────────────────── -->
  {
    bloques.map((b, i) => (
      <section class:list={['seccion', { 'seccion--papel': i % 2 === 1 }]}>
        <div class="env">
          <div class="cabecera-seccion">
            <h2 class="titulo">{b.titulo}</h2>
            <a href={b.enlace} class="enlace-mas">Ver todos</a>
          </div>

          <div class="rejilla">
            {b.productos.map((p) => <ProductoCard producto={p} />)}
            {i === bloques.length - 1 && (
              <a href="/catalogo" class="celda-cta">
                <span class="celda-cta__k">¿Buscas otra cosa?</span>
                <span class="celda-cta__t">Los {productos.length} productos, con filtros por precio y departamento</span>
                <span class="enlace-mas">Ir al catálogo</span>
              </a>
            )}
          </div>
        </div>
      </section>
    ))
  }
  </>
  )}
</Base>

<style>
  /* Banner */
  .banner {
    position: relative;
    /* Más horizontal que antes: las categorías quedan visibles sin bajar mucho. */
    min-height: clamp(340px, 38vw, 500px);
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--linea);
  }

  .banner__foto,
  .banner__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .banner__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--fondo) 95%, transparent) 0%, color-mix(in srgb, var(--fondo) 80%, transparent) 36%, transparent 64%);
  }

  .banner__env {
    position: relative;
    width: 100%;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .banner__texto {
    max-width: 34rem;
  }

  .banner__kicker {
    font-family: var(--titular);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--salvia);
    margin: 0 0 var(--e-4);
  }

  .banner__titulo {
    font-family: var(--display);
    font-size: var(--t-3xl);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.02em;
    color: var(--cafe);
    margin-bottom: var(--e-5);
  }

  .banner__plomo {
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--tinta);
    max-width: 36ch;
    margin-bottom: var(--e-6);
  }

  .banner__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .banner__control {
    position: absolute;
    right: var(--gutter);
    bottom: 1.1rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .banner__control > button {
    background: var(--cafe-suave);
    border: 1px solid color-mix(in srgb, var(--claro) 50%, transparent);
    color: var(--claro);
    width: 34px;
    height: 30px;
    border-radius: var(--radio);
    transition: background 0.2s;
  }

  .banner__control > button:hover {
    background: var(--cafe-texto);
  }

  .banner__puntos {
    display: flex;
    gap: 0.4rem;
  }

  .banner__puntos button {
    width: 22px;
    height: 3px;
    padding: 0;
    border: none;
    background: color-mix(in srgb, var(--claro) 50%, transparent);
    transition: background 0.25s;
  }

  .banner__puntos button.es-actual {
    background: var(--claro);
  }

  /* Beneficios */
  /* Franja de beneficios en kraft: el verde se reserva para lo que se pulsa. */
  .beneficios {
    background: var(--papel);
    color: var(--tinta);
    border-bottom: 1px solid var(--linea);
  }

  .beneficios__env {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .beneficio {
    padding: var(--e-5) var(--e-5);
    text-align: center;
    border-left: 1px solid var(--linea-fuerte);
  }

  .beneficio:first-child {
    border-left: none;
  }

  .beneficio__t {
    font-family: var(--titular);
    font-size: var(--t-base);
    font-weight: 600;
    color: var(--salvia);
    margin: 0 0 0.15rem;
  }

  .beneficio__d {
    font-size: var(--t-sm);
    color: var(--tinta-suave);
    margin: 0;
  }

  /* Departamentos: el nombre en la slab y cuántos productos tiene. Una
     regla verde arriba, como el filo de una etiqueta. */
  .deptos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--e-5);
    padding-block: var(--e-7) 0;
  }

  .depto {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-4);
    padding: var(--e-4) 0 var(--e-2);
    border-top: 3px solid var(--salvia);
    transition: border-color 0.2s;
  }

  .depto:hover {
    border-color: var(--cafe);
  }

  .depto__nombre {
    font-family: var(--display);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1.1;
    color: var(--cafe);
  }

  .depto__cuenta {
    font-family: var(--titular);
    font-size: var(--t-sm);
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .depto:hover .depto__nombre {
    color: var(--salvia);
  }

  /* Rejilla de productos */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--e-7) var(--e-6);
  }

  .celda-cta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--e-4);
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio-foto);
    padding: var(--e-6);
    background: var(--superficie);
    transition: border-color 0.2s, background 0.2s;
  }

  .celda-cta:hover {
    border-color: var(--salvia);
  }

  .celda-cta__k {
    font-family: var(--titular);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--salvia);
  }

  .celda-cta__t {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: 1.2;
    color: var(--cafe);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .banner__velo {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--fondo) 95%, transparent) 0%,
        color-mix(in srgb, var(--fondo) 86%, transparent) 45%,
        color-mix(in srgb, var(--fondo) 35%, transparent) 100%
      );
    }
    .banner__texto {
      max-width: none;
      text-align: center;
    }
    .banner__plomo {
      margin-inline: auto;
    }
    .banner__acciones {
      justify-content: center;
    }
    .beneficios__env {
      grid-template-columns: repeat(2, 1fr);
    }
    .deptos {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .beneficio:nth-child(odd) {
      border-left: none;
    }
    .beneficio:nth-child(n + 3) {
      border-top: 1px solid var(--linea-fuerte);
    }
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.4rem;
    }
  }

  @media (max-width: 560px) {
    .banner {
      min-height: 460px;
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
