---
import Admin from '../../layouts/Admin.astro';
import { COOKIE, traer } from '../../lib/admin.js';
import { urlCloudinary } from '../../lib/cloudinary.js';

export const prerender = false;

const token = Astro.cookies.get(COOKIE)?.value;
const yo = await traer('/yo', token);
if (!yo) return Astro.redirect('/admin');

const parametros = Astro.url.searchParams;
const filtros = {
  q: parametros.get('q') ?? '',
  categoria_id: parametros.get('categoria_id') ?? '',
  subcategoria_id: parametros.get('subcategoria_id') ?? '',
  marca_id: parametros.get('marca_id') ?? '',
  activo: parametros.get('activo') ?? '',
  stock_bajo: parametros.get('stock_bajo') === '1',
  orden: parametros.get('orden') ?? 'codigo',
};

const consulta = new URLSearchParams();
for (const [clave, valor] of Object.entries(filtros)) {
  if (valor === '' || valor === false) continue;
  consulta.set(clave, valor === true ? '1' : valor);
}

const [productos, clasificacion] = await Promise.all([
  traer(`/productos?${consulta}`, token),
  traer('/clasificacion', token),
]);

const listaProductos = productos ?? [];
const categorias = clasificacion?.categorias ?? [];
const marcas = clasificacion?.marcas ?? [];
// Planas, para el menú de filtro y para el de la ficha.
const subcategorias = categorias.flatMap((c) =>
  c.subcategorias.map((s) => ({ ...s, categoria: c.nombre, categoria_id: c.id }))
);

const ORDENES = [
  { id: 'codigo', nombre: 'Código' },
  { id: 'nuevos', nombre: 'Últimos agregados' },
  { id: 'editados', nombre: 'Editados hace poco' },
  { id: 'nombre', nombre: 'Nombre A-Z' },
  { id: 'stock', nombre: 'Menos stock primero' },
  { id: 'precio', nombre: 'Precio, de mayor a menor' },
];

const STOCK_BAJO = 5;
const soles = (n) => 'S/ ' + Number(n).toFixed(2);

const activos = listaProductos.filter((p) => p.activo).length;
const escasos = listaProductos.filter((p) => p.activo && p.stock <= STOCK_BAJO).length;
const hayFiltros = [...consulta.keys()].some((k) => k !== 'orden');
---

<Admin title="Productos" seccion="productos" sesion={true}>
  <header class="cab">
    <div>
      <p class="kicker">Panel</p>
      <h1 class="titulo">Productos</h1>
    </div>
    <p class="cab__resumen">
      {listaProductos.length} en la lista · {activos} activos ·
      <strong class:list={[escasos > 0 && 'alerta']}>{escasos} con poco stock</strong>
    </p>
  </header>

  <div
    class="barra"
    x-data={`catalogoAdmin(${JSON.stringify({
      marcas,
      categorias: categorias.map((c) => ({ id: c.id, nombre: c.nombre })),
      subcategorias,
    })})`}
  >
    <form class="filtros" method="get">
      <label class="campo">
        <span class="campo__etq">Buscar</span>
        <input type="search" name="q" value={filtros.q} placeholder="Nombre o código" />
      </label>

      <label class="campo">
        <span class="campo__etq">Categoría</span>
        <select name="categoria_id">
          <option value="">Todas</option>
          {categorias.map((c) => (
            <option value={c.id} selected={filtros.categoria_id === String(c.id)}>
              {c.nombre}
            </option>
          ))}
        </select>
      </label>

      <label class="campo">
        <span class="campo__etq">Subcategoría</span>
        <select name="subcategoria_id">
          <option value="">Todas</option>
          {subcategorias.map((s) => (
            <option value={s.id} selected={filtros.subcategoria_id === String(s.id)}>
              {s.categoria} - {s.nombre}
            </option>
          ))}
        </select>
      </label>

      <label class="campo">
        <span class="campo__etq">Marca</span>
        <select name="marca_id">
          <option value="">Todas</option>
          {marcas.map((m) => (
            <option value={m.id} selected={filtros.marca_id === String(m.id)}>
              {m.nombre}
            </option>
          ))}
        </select>
      </label>

      <label class="campo">
        <span class="campo__etq">Estado</span>
        <select name="activo">
          <option value="">Todos</option>
          <option value="true" selected={filtros.activo === 'true'}>Activos</option>
          <option value="false" selected={filtros.activo === 'false'}>Inactivos</option>
        </select>
      </label>

      <label class="campo">
        <span class="campo__etq">Ordenar por</span>
        <select name="orden">
          {ORDENES.map((o) => (
            <option value={o.id} selected={filtros.orden === o.id}>{o.nombre}</option>
          ))}
        </select>
      </label>

      <label class="casilla casilla--filtro">
        <input type="checkbox" name="stock_bajo" value="1" checked={filtros.stock_bajo} />
        Solo con poco stock
      </label>

      <div class="filtros__botones">
        <button class="btn" type="submit">Filtrar</button>
        {hayFiltros && <a href="/admin/productos" class="filtros__limpiar">Limpiar</a>}
      </div>
    </form>

    <div class="acciones">
      <button class="btn" type="button" @click="abrirNuevo()">Nuevo producto</button>
      <a class="btn btn--linea" href="/admin/categorias" title="Crear, editar o mandar a la papelera marcas, categorías y subcategorías">Marcas y categorías</a>
      <a class="btn btn--linea" href="/api/admin/productos/exportar" download>Exportar TSV</a>
      <label class="btn btn--linea importar">
        <span x-text="importando ? 'Importando…' : 'Importar TSV'">Importar TSV</span>
        <input type="file" accept=".tsv,.txt,text/tab-separated-values" @change="importar($event)" />
      </label>
    </div>

    <p class="mensaje" x-show="mensaje" x-text="mensaje" :class="error && 'mensaje--error'" x-cloak></p>

    <!-- Vista previa de la importación: nada se guarda hasta confirmar. -->
    <section class="previa" x-show="previa" x-cloak>
      <h2 class="previa__t">Vista previa de la planilla</h2>
      <template x-for="a in previa?.avisos || []">
        <p class="previa__aviso" x-text="a"></p>
      </template>

      <template x-if="previa && previa.errores.length === 0">
        <div>
          <p>
            Se van a crear <strong x-text="previa.creados"></strong> productos y actualizar
            <strong x-text="previa.actualizados"></strong>. Las celdas de texto vacías borran el
            dato actual; las de activo, destacado y más vendido vacías lo dejan como está.
          </p>
          <p class="previa__aviso" x-show="previa.codigos_nuevos.length" x-text="'Nuevos: ' + previa.codigos_nuevos.join(', ')"></p>
          <div class="acciones">
            <button class="btn" type="button" @click="confirmarImport()" :disabled="importando">
              <span x-text="importando ? 'Importando…' : 'Confirmar importación'"></span>
            </button>
            <button class="btn btn--linea" type="button" @click="cancelarImport()" :disabled="importando">Cancelar</button>
          </div>
        </div>
      </template>

      <template x-if="previa && previa.errores.length > 0">
        <div>
          <p class="mensaje--error">
            No se guardó nada. Corrige estas <span x-text="previa.errores.length"></span> líneas y vuelve a subir el archivo:
          </p>
          <ul class="previa__errores">
            <template x-for="e in previa.errores.slice(0, 50)">
              <li x-text="e"></li>
            </template>
          </ul>
          <p class="previa__aviso" x-show="previa.errores.length > 50" x-text="'… y ' + (previa.errores.length - 50) + ' más.'"></p>
          <button class="btn btn--linea" type="button" @click="cancelarImport()">Cerrar</button>
        </div>
      </template>
    </section>

    <!-- ── Tabla ────────────────────────────────────────────── -->
    <table class="tabla">
      <thead>
        <tr>
          <th>Foto</th>
          <th>Código</th>
          <th>Producto</th>
          <th>Clasificación</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          listaProductos.map((p) => (
            <tr
              x-data={`filaProducto(${JSON.stringify({
                codigo: p.codigo,
                stock: p.stock,
                activo: p.activo,
              })})`}
              :class="!activo && 'fila--inactiva'"
            >
              <td>
                {p.imagenes.length > 0 ? (
                  <img class="mini" src={urlCloudinary(p.imagenes[0].url, 80)} alt="" width="40" height="48" loading="lazy" />
                ) : (
                  <span class="mini mini--vacia" title="Sin foto">—</span>
                )}
              </td>
              <td class="celda-codigo">{p.codigo}</td>
              <td>
                <strong>{p.nombre}</strong>
                <span class="sub">{p.presentacion}</span>
              </td>
              <td class="sub">
                {p.subcategoria.categoria.nombre} · {p.subcategoria.nombre}
                <span class="sub">{p.marca.nombre}</span>
              </td>
              <td>
                {soles(p.precio)}
                {p.precio_antes && <span class="sub">antes {soles(p.precio_antes)}</span>}
              </td>
              <td>
                <input
                  class="stock"
                  type="number"
                  min="0"
                  x-model.number="stock"
                  @change="guardarStock()"
                  :class="stock <= 5 && activo && 'stock--bajo'"
                />
              </td>
              <td>
                <button
                  type="button"
                  class="pastilla"
                  :class="activo ? 'pastilla--si' : 'pastilla--no'"
                  @click="alternarActivo()"
                  x-text="activo ? 'Activo' : 'Inactivo'"
                >
                  {p.activo ? 'Activo' : 'Inactivo'}
                </button>
              </td>
              <td>
                <button type="button" class="enlace-boton" @click="$dispatch('editar-producto', { codigo })">
                  Editar
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    {
      listaProductos.length === 0 && (
        <p class="vacio">
          {hayFiltros
            ? 'Ningún producto coincide con esos filtros.'
            : 'Todavía no hay productos.'}
        </p>
      )
    }

    <!-- ── Ficha lateral ────────────────────────────────────── -->
    <div class="panel-lateral" x-show="abierto" x-cloak @editar-producto.window="abrirEdicion($event.detail.codigo)">
      <div class="panel-lateral__velo" @click="cerrar()"></div>

      <form class="panel-lateral__caja" @submit.prevent="guardar()">
        <header class="ficha__cab">
          <h2 x-text="nuevo ? 'Nuevo producto' : 'Editar ' + form.codigo">Producto</h2>
          <button type="button" @click="cerrar()" aria-label="Cerrar">✕</button>
        </header>

        <div class="ficha__cuerpo">
          <div class="par">
            <label class="campo">
              <span class="campo__etq">Código (SKU)</span>
              <input type="text" x-model="form.codigo" :disabled="!nuevo" required />
            </label>
            <label class="campo">
              <span class="campo__etq">Presentación</span>
              <input type="text" x-model="form.presentacion" maxlength="120" placeholder="500 g, 1 L…" />
            </label>
          </div>

          <label class="campo">
            <span class="campo__etq">Nombre</span>
            <input type="text" x-model="form.nombre" maxlength="150" @input="sugerirSlug()" required />
          </label>

          <label class="campo">
            <span class="campo__etq">Slug (la dirección en la tienda)</span>
            <input type="text" x-model="form.slug" pattern="[a-z0-9-]+" required />
          </label>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">Marca</span>
              <select x-model.number="form.marca_id" @change="cambiarMarca()" required>
                <option value="">Elige la marca</option>
                <template x-for="m in marcas" :key="m.id">
                  <option :value="m.id" x-text="m.nombre"></option>
                </template>
                <option value="nueva">+ Crear una marca nueva…</option>
              </select>
            </label>
            <label class="campo">
              <span class="campo__etq">Categoría</span>
              <select x-model.number="form.categoria_id" @change="cambiarCategoria()" required>
                <option value="">Elige la categoría</option>
                <template x-for="c in categorias" :key="c.id">
                  <option :value="c.id" x-text="c.nombre"></option>
                </template>
                <option value="nueva">+ Crear una categoría nueva…</option>
              </select>
            </label>
          </div>

          <label class="campo">
            <span class="campo__etq">Subcategoría</span>
            <select x-model.number="form.subcategoria_id" @change="cambiarSubcategoria()" :disabled="!form.categoria_id" required>
              <option value="">Elige la subcategoría</option>
              <template x-for="s in subcategoriasDe(form.categoria_id)" :key="s.id">
                <option :value="s.id" x-text="s.nombre"></option>
              </template>
              <option value="nueva" x-show="form.categoria_id">+ Crear una subcategoría nueva…</option>
            </select>
          </label>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">Precio</span>
              <input type="number" step="0.10" min="0" x-model="form.precio" required />
            </label>
            <label class="campo">
              <span class="campo__etq">Precio antes (oferta)</span>
              <input type="number" step="0.10" min="0" x-model="form.precio_antes" placeholder="Vacío = sin oferta" />
            </label>
          </div>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">Stock</span>
              <input type="number" min="0" x-model.number="form.stock" required />
            </label>
            <div class="campo">
              <span class="campo__etq">Marcas de portada</span>
              <label class="casilla"><input type="checkbox" x-model="form.activo" /> Activo</label>
              <label class="casilla"><input type="checkbox" x-model="form.destacado" /> Destacado</label>
              <label class="casilla"><input type="checkbox" x-model="form.mas_vendido" /> Más vendido</label>
            </div>
          </div>

          <label class="campo">
            <span class="campo__etq">Descripción corta</span>
            <textarea x-model="form.descripcion_corta" rows="2" maxlength="160"></textarea>
            <span class="campo__contador" x-text="(form.descripcion_corta || '').length + ' / 160'"></span>
          </label>

          <label class="campo">
            <span class="campo__etq">Descripción larga</span>
            <textarea x-model="form.descripcion_larga" rows="4" maxlength="1500"></textarea>
            <span class="campo__contador" x-text="(form.descripcion_larga || '').length + ' / 1500'"></span>
          </label>

          <label class="campo">
            <span class="campo__etq">Modo de uso</span>
            <textarea x-model="form.modo_uso" rows="3" maxlength="600"></textarea>
            <span class="campo__contador" x-text="(form.modo_uso || '').length + ' / 600'"></span>
          </label>

          <label class="campo">
            <span class="campo__etq">Beneficios (uno por línea, hasta 8 de 80 letras)</span>
            <textarea x-model="beneficiosTexto" rows="4" maxlength="720" placeholder="Sin lactosa&#10;Rica en omegas"></textarea>
            <span class="campo__contador" x-text="beneficiosTexto.split('
').filter((l) => l.trim()).length + ' / 8 beneficios'"></span>
          </label>

          <!-- Fotos: solo con el producto ya creado, porque se guardan por código. -->
          <div class="fotos" x-show="!nuevo">
            <span class="campo__etq">Fotos</span>
            <p class="fotos__ayuda">La primera es la que se ve en el catálogo.</p>

            <div class="fotos__lista">
              <template x-for="(img, i) in fotos" :key="img.id">
                <figure class="foto">
                  <img :src="miniatura(img.url)" alt="" width="70" height="84" />
                  <figcaption>
                    <span x-text="img.tipo || 'foto'"></span>
                    <span class="foto__acciones">
                      <button type="button" @click="moverFoto(i, -1)" :disabled="i === 0" title="Subir">↑</button>
                      <button type="button" @click="moverFoto(i, 1)" :disabled="i === fotos.length - 1" title="Bajar">↓</button>
                      <button type="button" class="foto__borrar" @click="borrarFoto(img.id)" title="Borrar">🗑</button>
                    </span>
                  </figcaption>
                </figure>
              </template>
              <p class="fotos__vacio" x-show="fotos.length === 0">Este producto todavía no tiene fotos.</p>
            </div>

            <label class="btn btn--linea importar">
              <span x-text="subiendo ? 'Subiendo…' : 'Agregar foto'">Agregar foto</span>
              <input type="file" accept="image/*" @change="subirFoto($event)" />
            </label>
          </div>

          <p class="mensaje" x-show="mensajeFicha" x-text="mensajeFicha" :class="errorFicha && 'mensaje--error'"></p>
        </div>

        <footer class="ficha__pie">
          <button type="button" class="btn btn--linea" @click="cerrar()">Cancelar</button>
          <button type="submit" class="btn" :disabled="guardando">
            <span x-text="guardando ? 'Guardando…' : 'Guardar'">Guardar</span>
          </button>
        </footer>
      </form>
    </div>
  </div>
</Admin>

<style>
  .cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.8rem;
  }

  .cab__resumen {
    color: var(--tinta-suave);
    font-size: 0.9rem;
    margin: 0;
  }

  .alerta {
    color: var(--henna);
  }

  .filtros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    align-items: end;
    gap: 0.8rem;
    background: #fff;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .filtros .campo {
    margin-bottom: 0;
  }

  .filtros__botones {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .casilla--filtro {
    font-size: 0.84rem;
    color: var(--tinta-suave);
  }

  .filtros__limpiar {
    font-size: 0.8rem;
    color: var(--tinta-suave);
    border-bottom: 1px solid currentColor;
  }

  .acciones {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .importar {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .importar input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .previa {
    background: #fff;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.1rem 1.3rem;
    margin-bottom: 1.2rem;
  }

  .previa__t {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }

  .previa__aviso {
    font-size: 0.82rem;
    color: var(--tinta-suave);
  }

  .previa__errores {
    max-height: 14rem;
    overflow-y: auto;
    font-size: 0.84rem;
    padding-left: 1.2rem;
    margin: 0.5rem 0 1rem;
  }

  .mensaje {
    font-size: 0.88rem;
    color: var(--salvia);
    margin: 0 0 1rem;
  }

  .mensaje--error {
    color: var(--rojo);
  }

  .tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    background: #fff;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
  }

  .tabla th {
    text-align: left;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    font-weight: 700;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--linea);
  }

  .tabla td {
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--linea);
    vertical-align: middle;
  }

  .tabla tbody tr:last-child td {
    border-bottom: none;
  }

  .fila--inactiva {
    opacity: 0.55;
  }

  .celda-codigo {
    font-family: var(--titular);
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .sub {
    display: block;
    font-size: 0.78rem;
    color: var(--tinta-suave);
  }

  .mini {
    width: 40px;
    height: 48px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--papel);
  }

  .mini--vacia {
    display: grid;
    place-items: center;
    color: var(--linea-fuerte);
  }

  .stock {
    width: 72px;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    font: inherit;
  }

  .stock--bajo {
    border-color: var(--henna);
    color: var(--henna);
    font-weight: 700;
  }

  .pastilla {
    border: 1px solid currentColor;
    background: none;
    border-radius: 3px;
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pastilla--si {
    color: var(--salvia);
  }

  .pastilla--no {
    color: var(--tinta-suave);
  }

  .enlace-boton {
    background: none;
    border: none;
    padding: 0;
    color: var(--salvia);
    font-size: 0.84rem;
    border-bottom: 1px solid currentColor;
  }

  .vacio {
    color: var(--tinta-suave);
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 2.5rem 1.5rem;
    text-align: center;
    margin-top: 1rem;
  }

  /* Ficha lateral */
  .panel-lateral {
    position: fixed;
    inset: 0;
    z-index: 80;
  }

  .panel-lateral__velo {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--salvia-osc) 35%, transparent);
  }

  .panel-lateral__caja {
    position: absolute;
    top: 0;
    right: 0;
    width: min(560px, 100%);
    height: 100%;
    background: var(--fondo);
