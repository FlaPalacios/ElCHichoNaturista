---
import Admin from '../../layouts/Admin.astro';
import { COOKIE, traer } from '../../lib/admin.js';

export const prerender = false;

// La sesión se comprueba en el servidor: si el token no sirve, ni siquiera se
// renderiza el panel.
const token = Astro.cookies.get(COOKIE)?.value;
const yo = await traer('/yo', token);
const sesion = Boolean(yo);

const filtros = {
  estado: Astro.url.searchParams.get('estado') ?? '',
  q: Astro.url.searchParams.get('q') ?? '',
};

let pedidos = [];
let apiCaida = false;
if (sesion) {
  const parametros = new URLSearchParams();
  if (filtros.estado) parametros.set('estado', filtros.estado);
  if (filtros.q) parametros.set('q', filtros.q);
  const respuesta = await traer(`/pedidos?${parametros}`, token);
  apiCaida = respuesta === undefined;
  pedidos = respuesta ?? [];
}

const ESTADOS = [
  { id: 'nuevo', nombre: 'Nuevo' },
  { id: 'pago_confirmado', nombre: 'Pago confirmado' },
  { id: 'preparando', nombre: 'Preparando' },
  { id: 'enviado', nombre: 'Enviado' },
  { id: 'entregado', nombre: 'Entregado' },
  { id: 'cancelado', nombre: 'Cancelado' },
  { id: 'no_concretado', nombre: 'No concretado' },
];

const soles = (n) => 'S/ ' + Number(n).toFixed(2);
const fecha = (iso) =>
  new Date(iso).toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' });

// Los que esperan que Fernando haga algo.
const porAtender = pedidos.filter((p) => ['nuevo', 'pago_confirmado'].includes(p.estado)).length;
---

<Admin title="Pedidos" seccion="pedidos" sesion={sesion}>
  {
    !sesion && (
      <section class="acceso" x-data="{ usuario: '', password: '', error: '', entrando: false }">
        <img src="/logo-1.png" alt="" width="64" height="64" class="acceso__sello" />
        <h1 class="acceso__t">Panel interno</h1>
        <p class="acceso__d">Entra con tu usuario para gestionar pedidos y catálogo.</p>

        <form
          class="acceso__form"
          @submit.prevent="
            error = ''; entrando = true;
            fetch('/api/admin/sesion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ usuario, password })
            })
              .then(r => r.ok ? location.reload() : r.json().then(d => { error = d.error; entrando = false }))
              .catch(() => { error = 'No se pudo conectar con el servidor.'; entrando = false })
          "
        >
          <label class="campo">
            <span class="campo__etq">Usuario</span>
            <input type="text" x-model="usuario" autocomplete="username" required />
          </label>
          <label class="campo">
            <span class="campo__etq">Contraseña</span>
            <input type="password" x-model="password" autocomplete="current-password" required />
          </label>
          <button class="btn btn--bloque" type="submit" :disabled="entrando">
            <span x-text="entrando ? 'Entrando…' : 'Entrar'">Entrar</span>
          </button>
          <p class="acceso__error" x-show="error" x-text="error" x-cloak></p>
        </form>
      </section>
    )
  }

  {
    sesion && (
      <>
        <header class="cab">
          <div>
            <p class="kicker">Panel</p>
            <h1 class="titulo">Pedidos</h1>
          </div>
          <p class="cab__resumen">
            {pedidos.length} en la lista · <strong>{porAtender}</strong> por atender
          </p>
        </header>

        {apiCaida && (
          <p class="aviso-api">
            No se pudo hablar con la API. Comprueba que el backend esté levantado.
          </p>
        )}

        <form class="filtros" method="get">
          <label class="campo">
            <span class="campo__etq">Buscar</span>
            <input
              type="search"
              name="q"
              value={filtros.q}
              placeholder="Número de pedido, teléfono o nombre"
            />
          </label>
          <label class="campo">
            <span class="campo__etq">Estado</span>
            <select name="estado">
              <option value="">Todos</option>
              {ESTADOS.map((e) => (
                <option value={e.id} selected={filtros.estado === e.id}>
                  {e.nombre}
                </option>
              ))}
            </select>
          </label>
          <button class="btn" type="submit">Filtrar</button>
          {(filtros.q || filtros.estado) && (
            <a href="/admin" class="filtros__limpiar">Limpiar</a>
          )}
        </form>

        {pedidos.length === 0 && !apiCaida && (
          <p class="vacio">
            {filtros.q || filtros.estado
              ? 'Ningún pedido coincide con ese filtro.'
              : 'Todavía no hay pedidos. Cuando entre el primero, aparece acá.'}
          </p>
        )}

        <div class="lista">
          {pedidos.map((p) => (
            <article
              class="pedido"
              x-data={`pedidoAdmin(${JSON.stringify({
                numero: p.numero_pedido,
                estado: p.estado,
                courier: p.courier ?? '',
                seguimiento: p.codigo_seguimiento ?? '',
                nota: p.nota_interna ?? '',
                telefono: p.telefono_contacto,
              })})`}
            >
              <div class="pedido__cab">
                <div>
                  <p class="pedido__numero">{p.numero_pedido}</p>
                  <p class="pedido__fecha">{fecha(p.creado_en)}</p>
                </div>
                <span class="etiqueta" :class="'etiqueta--' + estado" x-text="nombreEstado()">
                  {ESTADOS.find((e) => e.id === p.estado)?.nombre}
                </span>
                <p class="pedido__total">{soles(p.total)}</p>
                <button class="pedido__abrir" @click="abierto = !abierto" type="button">
                  <span x-text="abierto ? 'Cerrar' : 'Ver detalle'">Ver detalle</span>
                </button>
              </div>

              <div class="pedido__cliente">
                <span>{p.nombre_contacto}</span>
                <span>·</span>
                <a href={`https://wa.me/51${p.telefono_contacto.replace(/\D/g, '').slice(-9)}`} target="_blank" rel="noopener">
                  {p.telefono_contacto}
                </a>
                <span>·</span>
                <span>{p.distrito}, {p.provincia}, {p.departamento}</span>
              </div>

              <div class="pedido__cuerpo" x-show="abierto" x-cloak x-transition.opacity>
                <div class="detalle">
                  <div>
                    <h3 class="detalle__t">Productos</h3>
                    <ul class="detalle__items">
                      {p.items.map((i) => (
                        <li>
                          <span>{i.cantidad} × {i.producto.nombre}</span>
                          <span>{soles(i.precio_unitario * i.cantidad)}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="detalle__cuenta"><span>Subtotal</span><span>{soles(p.subtotal)}</span></p>
                    <p class="detalle__cuenta"><span>Envío</span><span>{Number(p.envio) === 0 ? 'Gratis' : soles(p.envio)}</span></p>
                    <p class="detalle__cuenta detalle__cuenta--total"><span>Total</span><span>{soles(p.total)}</span></p>
                  </div>

                  <div>
                    <h3 class="detalle__t">Entrega</h3>
                    <dl class="detalle__datos">
                      <div><dt>Dirección</dt><dd>{p.direccion_envio}</dd></div>
                      {p.referencia && <div><dt>Referencia</dt><dd>{p.referencia}</dd></div>}
                      <div><dt>Distrito</dt><dd>{p.distrito}, {p.provincia}</dd></div>
                      <div><dt>Departamento</dt><dd>{p.departamento}</dd></div>
                      {p.email_contacto && <div><dt>Correo</dt><dd>{p.email_contacto}</dd></div>}
                      {p.nota && <div><dt>Nota del cliente</dt><dd>{p.nota}</dd></div>}
                    </dl>

                    <a
                      class="btn btn--wa btn--bloque"
                      href={`https://wa.me/51${p.telefono_contacto.replace(/\D/g, '').slice(-9)}?text=${encodeURIComponent(`Hola ${p.nombre_contacto}, te escribimos por tu pedido ${p.numero_pedido}.`)}`}
                      target="_blank"
                      rel="noopener"
                    >
                      Abrir WhatsApp
                    </a>
                  </div>

                  <div>
                    <h3 class="detalle__t">Gestión</h3>

                    <label class="campo">
                      <span class="campo__etq">Estado</span>
                      <select x-model="estado" @change="guardarEstado()">
                        {ESTADOS.map((e) => <option value={e.id}>{e.nombre}</option>)}
                      </select>
                    </label>

                    <div x-show="estado === 'enviado'" x-cloak>
                      <label class="campo">
                        <span class="campo__etq">Courier</span>
                        <input type="text" x-model="courier" placeholder="Olva, Shalom…" @change="guardarEstado()" />
                      </label>
                      <label class="campo">
                        <span class="campo__etq">Código de seguimiento</span>
                        <input type="text" x-model="seguimiento" @change="guardarEstado()" />
                      </label>
                    </div>

                    <label class="campo">
                      <span class="campo__etq">Nota interna</span>
                      <textarea x-model="nota" rows="3" @change="guardarNota()" placeholder="Solo la ves tú"></textarea>
                    </label>

                    <p class="guardado" x-show="mensaje" x-text="mensaje" x-cloak></p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    )
  }
</Admin>

<style>
  .acceso {
    width: 100%;
    max-width: 360px;
    text-align: center;
  }

  .acceso__sello {
    margin: 0 auto 1rem;
  }

  .acceso__t {
    font-size: 1.6rem;
  }

  .acceso__d {
    color: var(--tinta-suave);
    font-size: 0.92rem;
    margin-bottom: 1.6rem;
  }

  .acceso__form {
    text-align: left;
  }

  .acceso__error {
    color: var(--rojo);
    font-size: 0.86rem;
    margin: 0.8rem 0 0;
    text-align: center;
  }

  .cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.8rem;
  }

  .cab__resumen {
    color: var(--tinta-suave);
    font-size: 0.9rem;
    margin: 0;
  }

  .aviso-api {
    border-left: 3px solid var(--rojo);
    padding-left: 0.9rem;
    color: var(--rojo);
    font-size: 0.9rem;
  }

  .filtros {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .filtros .campo {
    margin-bottom: 0;
    flex: 1 1 200px;
  }

  .filtros__limpiar {
    font-size: 0.8rem;
    color: var(--tinta-suave);
    border-bottom: 1px solid currentColor;
  }

  .vacio {
    color: var(--tinta-suave);
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .lista {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .pedido {
    background: #fff;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1rem 1.2rem;
  }

  .pedido__cab {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 1.2rem;
  }

  .pedido__numero {
    font-family: var(--titular);
    font-weight: 600;
    margin: 0;
  }

  .pedido__fecha {
    font-size: 0.78rem;
    color: var(--tinta-suave);
    margin: 0;
  }

  .pedido__total {
    font-family: var(--titular);
    font-size: 1.1rem;
    margin: 0;
  }

  .pedido__abrir {
    background: none;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 0.4rem 0.8rem;
    font-size: 0.78rem;
    color: var(--tinta-suave);
  }

  .pedido__abrir:hover {
    border-color: var(--salvia);
    color: var(--salvia);
  }

  .pedido__cliente {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }

  .pedido__cliente a:hover {
    color: var(--salvia);
  }

  .pedido__cuerpo {
    border-top: 1px solid var(--linea);
    margin-top: 1rem;
    padding-top: 1.2rem;
  }

  .etiqueta {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    border: 1px solid currentColor;
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .etiqueta--nuevo {
    color: var(--henna);
  }

  .etiqueta--pago_confirmado,
  .etiqueta--preparando {
    color: var(--salvia);
  }

  .etiqueta--enviado {
    color: var(--jade);
  }

  .etiqueta--entregado {
    color: var(--salvia-osc);
    background: var(--papel);
  }

  .etiqueta--cancelado,
  .etiqueta--no_concretado {
    color: var(--rojo);
  }

  .detalle {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2rem;
  }

  .detalle__t {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 0.8rem;
  }

  .detalle__items {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0;
    font-size: 0.9rem;
  }

  .detalle__items li,
  .detalle__cuenta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.3rem 0;
  }

  .detalle__cuenta {
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .detalle__cuenta--total {
    border-top: 1px solid var(--linea);
    margin-top: 0.4rem;
    padding-top: 0.5rem;
    font-family: var(--titular);
    font-size: 1.05rem;
    color: var(--cafe);
  }

  .detalle__datos {
    margin: 0 0 1rem;
    font-size: 0.88rem;
  }

  .detalle__datos div {
    margin-bottom: 0.6rem;
  }

  .detalle__datos dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .detalle__datos dd {
    margin: 0.1rem 0 0;
  }

  .guardado {
    font-size: 0.82rem;
    color: var(--salvia);
    margin: 0;
  }

  @media (max-width: 700px) {
    .pedido__cab {
      grid-template-columns: 1fr auto;
      row-gap: 0.6rem;
    }
  }
</style>
