---
import Admin from '../../layouts/Admin.astro';
import { COOKIE, traer } from '../../lib/admin.js';

export const prerender = false;

// La sesión se comprueba en el servidor: si el token no sirve, ni siquiera se
// renderiza el panel.
const token = Astro.cookies.get(COOKIE)?.value;
const yo = await traer('/yo', token);
const sesion = Boolean(yo);

const filtros = {
  estado: Astro.url.searchParams.get('estado') ?? '',
  q: Astro.url.searchParams.get('q') ?? '',
};

let pedidos = [];
let productos = [];
let apiCaida = false;
if (sesion) {
  // Para el formulario de venta manual: todos, también los inactivos.
  productos = ((await traer('/productos?orden=nombre', token)) ?? []).map((p) => ({
    id: p.id,
    codigo: p.codigo,
    nombre: p.nombre,
    precio: p.precio,
    stock: p.stock,
    activo: p.activo,
  }));
  const parametros = new URLSearchParams();
  if (filtros.estado) parametros.set('estado', filtros.estado);
  if (filtros.q) parametros.set('q', filtros.q);
  const respuesta = await traer(`/pedidos?${parametros}`, token);
  apiCaida = respuesta === undefined;
  pedidos = respuesta ?? [];
}

const ESTADOS = [
  { id: 'pendiente', nombre: 'Pendiente' },
  { id: 'pagado', nombre: 'Pagado' },
  { id: 'enviado', nombre: 'Enviado' },
  { id: 'completado', nombre: 'Completado' },
  { id: 'cancelado', nombre: 'Cancelado' },
];

const soles = (n) => 'S/ ' + Number(n).toFixed(2);
const wa = (telefono, texto) =>
  `https://wa.me/51${telefono.replace(/\D/g, '').slice(-9)}` +
  (texto ? `?text=${encodeURIComponent(texto)}` : '');
const fecha = (iso) =>
  new Date(iso).toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' });

// Los que esperan que Fernando haga algo: confirmar el pago o despachar.
const porAtender = pedidos.filter((p) => ['pendiente', 'pagado'].includes(p.estado)).length;

// Un pedido que lleva más de 48 horas sin pagarse: hay que decidir si se cancela.
const HORAS_SIN_PAGO = 48;
const sinPagoHace = (p) =>
  p.estado === 'pendiente'
    ? Math.floor((Date.now() - new Date(p.creado_en).getTime()) / 3_600_000)
    : 0;
const demorado = (p) => sinPagoHace(p) >= HORAS_SIN_PAGO;
const demorados = pedidos.filter(demorado).length;
---

<Admin title="Pedidos" seccion="pedidos" sesion={sesion}>
  {
    !sesion && (
      <section class="acceso" x-data="{ usuario: '', password: '', error: '', entrando: false }">
        <img src="/logo-1.png" alt="" width="64" height="64" class="acceso__sello" />
        <h1 class="acceso__t">Panel interno</h1>
        <p class="acceso__d">Entra con tu usuario para gestionar pedidos y catálogo.</p>

        <form
          class="acceso__form"
          @submit.prevent="
            error = ''; entrando = true;
            fetch('/api/admin/sesion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ usuario, password })
            })
              .then(r => r.ok ? location.reload() : r.json().then(d => { error = d.error; entrando = false }))
              .catch(() => { error = 'No se pudo conectar con el servidor.'; entrando = false })
          "
        >
          <label class="campo">
            <span class="campo__etq">Usuario</span>
            <input type="text" x-model="usuario" autocomplete="username" required />
          </label>
          <label class="campo">
            <span class="campo__etq">Contraseña</span>
            <input type="password" x-model="password" autocomplete="current-password" required />
          </label>
          <button class="btn btn--bloque" type="submit" :disabled="entrando">
            <span x-text="entrando ? 'Entrando…' : 'Entrar'">Entrar</span>
          </button>
          <p class="acceso__error" x-show="error" x-text="error" x-cloak></p>
        </form>
      </section>
    )
  }

  {
    sesion && (
      <>
        <header class="cab">
          <div>
            <p class="kicker">Panel</p>
            <h1 class="titulo">Pedidos</h1>
          </div>
          <p class="cab__resumen">
            {pedidos.length} en la lista · <strong>{porAtender}</strong> por atender
            {demorados > 0 && <> · <strong class="cab__alerta">{demorados} sin pagar hace más de 48 h</strong></>}
          </p>
          <div class="cab__acciones">
          <button class="btn" type="button" x-data @click="$dispatch('venta-manual')">
            Registrar venta manual
          </button>
          <a
            class="btn btn--linea"
            href="/api/admin/export/pedidos.csv"
            download
            title="Historial completo para la pestaña Importar pedidos del Google Sheet"
          >
            Exportar pedidos (CSV)
          </a>
          </div>
        </header>

        {apiCaida && (
          <p class="aviso-api">
            No se pudo hablar con la API. Comprueba que el backend esté levantado.
          </p>
        )}

        <form class="filtros" method="get">
          <label class="campo">
            <span class="campo__etq">Buscar</span>
            <input
              type="search"
              name="q"
              value={filtros.q}
              placeholder="V-014, código web, teléfono o nombre"
            />
          </label>
          <label class="campo">
            <span class="campo__etq">Estado</span>
            <select name="estado">
              <option value="">Todos</option>
              {ESTADOS.map((e) => (
                <option value={e.id} selected={filtros.estado === e.id}>
                  {e.nombre}
                </option>
              ))}
            </select>
          </label>
          <button class="btn" type="submit">Filtrar</button>
          {(filtros.q || filtros.estado) && (
            <a href="/admin" class="filtros__limpiar">Limpiar</a>
          )}
        </form>

        {pedidos.length === 0 && !apiCaida && (
          <p class="vacio">
            {filtros.q || filtros.estado
              ? 'Ningún pedido coincide con ese filtro.'
              : 'Todavía no hay pedidos. Cuando entre el primero, aparece acá.'}
          </p>
        )}

        <div class="lista">
          {pedidos.map((p) => (
            <article
              class="pedido"
              x-data={`pedidoAdmin(${JSON.stringify({
                numero: p.numero_pedido,
                estado: p.estado,
                courier: p.courier ?? '',
                seguimiento: p.codigo_seguimiento ?? '',
                nota: p.nota_interna ?? '',
                telefono: p.telefono_contacto,
                fechaPago: '',
                fechaPagoIso: p.fecha_pago ?? '',
              })})`}
            >
              <div class="pedido__cab">
                <div>
                  <p class="pedido__numero">{p.codigo_venta}</p>
                  <p class="pedido__fecha">
                    {p.numero_pedido} · {fecha(p.creado_en)}
                  </p>
                </div>
                <span class="etiqueta" :class="'etiqueta--' + estado" x-text="nombreEstado()">
                  {ESTADOS.find((e) => e.id === p.estado)?.nombre}
                </span>
                {demorado(p) && (
                  <span class="aviso-demora" x-show="estado === 'pendiente'">
                    Sin pagar hace {Math.floor(sinPagoHace(p) / 24)} días
                  </span>
                )}
                <p class="pedido__total">{soles(p.total)}</p>
                <button class="pedido__abrir" @click="abierto = !abierto" type="button">
                  <span x-text="abierto ? 'Cerrar' : 'Ver detalle'">Ver detalle</span>
                </button>
              </div>

              <div class="pedido__cliente">
                <span>{p.nombre_contacto}</span>
                {p.telefono_contacto && (
                  <>
                    <span>·</span>
                    <a href={wa(p.telefono_contacto)} target="_blank" rel="noopener">
                      {p.telefono_contacto}
                    </a>
                  </>
                )}
                {p.distrito && (
                  <>
                    <span>·</span>
                    <span>{p.distrito}, {p.provincia}, {p.departamento}</span>
                  </>
                )}
                {p.origen === 'manual' && (
                  <>
                    <span>·</span>
                    <span class="pista-manual">Venta manual</span>
                  </>
                )}
              </div>

              <div class="pedido__cuerpo" x-show="abierto" x-cloak x-transition.opacity>
                <div class="detalle">
                  <div>
                    <h3 class="detalle__t">Productos</h3>
                    <ul class="detalle__items">
                      {p.items.map((i) => (
                        <li>
                          <span>{i.cantidad} × {i.producto.nombre}</span>
                          <span>{soles(i.precio_unitario * i.cantidad)}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="detalle__cuenta"><span>Subtotal</span><span>{soles(p.subtotal)}</span></p>
                    <p class="detalle__cuenta"><span>Envío</span><span>{Number(p.envio) === 0 ? 'Gratis' : soles(p.envio)}</span></p>
                    <p class="detalle__cuenta detalle__cuenta--total"><span>Total</span><span>{soles(p.total)}</span></p>
                  </div>

                  <div>
                    <h3 class="detalle__t">Entrega</h3>
                    <dl class="detalle__datos">
                      <div>
                        <dt>Código para el cliente</dt>
                        <dd>
                          <strong>{p.numero_pedido}</strong>
                          <br /><small>Lo consulta en <a href="/cuenta" target="_blank" rel="noopener">Mi cuenta</a></small>
                        </dd>
                      </div>
                      {p.direccion_envio && <div><dt>Dirección</dt><dd>{p.direccion_envio}</dd></div>}
                      {p.referencia && <div><dt>Referencia</dt><dd>{p.referencia}</dd></div>}
                      {p.distrito && <div><dt>Distrito</dt><dd>{p.distrito}, {p.provincia}</dd></div>}
                      {p.departamento && <div><dt>Departamento</dt><dd>{p.departamento}</dd></div>}
                      {p.email_contacto && <div><dt>Correo</dt><dd>{p.email_contacto}</dd></div>}
                      {p.nota && <div><dt>Nota del cliente</dt><dd>{p.nota}</dd></div>}
                    </dl>

                    {p.telefono_contacto && (
                      <a
                        class="btn btn--wa btn--bloque"
                        href={wa(p.telefono_contacto, `Hola ${p.nombre_contacto}, te escribimos por tu pedido ${p.numero_pedido}.`)}
                        target="_blank"
                        rel="noopener"
                      >
                        Abrir WhatsApp
                      </a>
                    )}
                  </div>

                  <div>
                    <h3 class="detalle__t">Gestión</h3>

                    <label class="campo">
                      <span class="campo__etq">Estado</span>
                      <select x-model="estado" @change="guardarEstado()">
                        {ESTADOS.map((e) => <option value={e.id}>{e.nombre}</option>)}
                      </select>
                    </label>

                    <label class="campo" x-show="estado !== 'pendiente'" x-cloak>
                      <span class="campo__etq">Fecha de pago (hora de Lima)</span>
                      <input type="datetime-local" x-model="fechaPago" @change="guardarFechaPago()" />
                    </label>

                    <div x-show="estado === 'enviado'" x-cloak>
                      <label class="campo">
                        <span class="campo__etq">Courier</span>
                        <input type="text" x-model="courier" maxlength="100" placeholder="Olva, Shalom…" @change="guardarEstado()" />
                      </label>
                      <label class="campo">
                        <span class="campo__etq">Código de seguimiento</span>
                        <input type="text" x-model="seguimiento" maxlength="100" @change="guardarEstado()" />
                      </label>
                    </div>

                    <label class="campo">
                      <span class="campo__etq">Nota interna</span>
                      <textarea x-model="nota" rows="3" maxlength="2000" @change="guardarNota()" placeholder="Solo la ves tú"></textarea>
                    </label>

                    <p class="guardado" x-show="mensaje" x-text="mensaje" x-cloak></p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- ── Venta manual ─────────────────────────────────── -->
        <div
          class="panel-lateral"
          x-data={`ventaManual(${JSON.stringify(productos)})`}
          x-show="abierto"
          x-cloak
          @venta-manual.window="abrir()"
          @keydown.escape.window="cerrar()"
        >
          <div class="panel-lateral__velo" @click="cerrar()"></div>

          <form class="panel-lateral__caja" @submit.prevent="guardar()">
            <header class="ficha__cab">
              <h2>Registrar venta manual</h2>
              <button type="button" @click="cerrar()" aria-label="Cerrar">✕</button>
            </header>

            <div class="ficha__cuerpo">
              <p class="ficha__ayuda">
                Para ventas cerradas por WhatsApp o en persona. Recibe su número de venta y un
                código ECN-M que puedes mandarle al cliente.
              </p>

              <div class="par">
                <label class="campo">
                  <span class="campo__etq">Cliente</span>
                  <input type="text" x-model="form.nombre" maxlength="150" required />
                </label>
                <label class="campo">
                  <span class="campo__etq">Teléfono (opcional)</span>
                  <input type="tel" x-model="form.telefono" maxlength="20" inputmode="tel" />
                </label>
              </div>

              <label class="campo">
                <span class="campo__etq">Fecha de la venta</span>
                <input type="date" x-model="form.fecha" required />
              </label>

              <h3 class="ficha__sub">Productos</h3>
              <template x-for="(linea, i) in form.lineas" :key="i">
                <div class="linea-venta">
                  <label class="campo">
                    <span class="campo__etq">Producto</span>
                    <select x-model="linea.producto_id" @change="elegido(linea)">
                      <option value="">Elegir…</option>
                      <template x-for="p in productos" :key="p.id">
                        <option :value="p.id" x-text="etiquetaProducto(p)"></option>
                      </template>
                    </select>
                  </label>
                  <label class="campo">
                    <span class="campo__etq">Cant.</span>
                    <input type="number" min="1" max="999" x-model="linea.cantidad" />
                  </label>
                  <label class="campo">
                    <span class="campo__etq">Precio (S/)</span>
                    <input type="number" min="0" step="0.01" x-model="linea.precio" />
                  </label>
                  <button
                    type="button"
                    class="linea-venta__quitar"
                    @click="quitarLinea(i)"
                    x-show="form.lineas.length > 1"
                    aria-label="Quitar producto"
                  >✕</button>
                </div>
              </template>
              <button type="button" class="btn btn--linea" @click="agregarLinea()">+ Otro producto</button>

              <div class="par venta-cuentas">
                <label class="campo">
                  <span class="campo__etq">Envío cobrado (S/)</span>
                  <input type="number" min="0" step="0.01" x-model="form.envio" />
                </label>
                <dl class="venta-total">
                  <div><dt>Subtotal</dt><dd x-text="soles(subtotal)"></dd></div>
                  <div><dt>Total</dt><dd x-text="soles(total)"></dd></div>
                </dl>
              </div>

              <label class="casilla">
                <input type="checkbox" x-model="form.pagado" />
                Ya está pagada (descuenta el stock ahora)
              </label>

              <label class="campo">
                <span class="campo__etq">Nota interna (opcional)</span>
                <textarea x-model="form.nota" rows="2" maxlength="2000" placeholder="Yape, entrega en mano…"></textarea>
              </label>

              <p class="venta-error" x-show="error" x-text="error" x-cloak></p>
            </div>

            <footer class="ficha__pie">
              <button type="button" class="btn btn--linea" @click="cerrar()">Cancelar</button>
              <button type="submit" class="btn" :disabled="guardando">
                <span x-text="guardando ? 'Guardando…' : 'Registrar venta'">Registrar venta</span>
              </button>
            </footer>
          </form>
        </div>
      </>
    )
  }
</Admin>

<style>
  .acceso {
    width: 100%;
    max-width: 360px;
    text-align: center;
  }

  .acceso__sello {
    margin: 0 auto 1rem;
  }

  .acceso__t {
    font-size: 1.6rem;
  }

  .acceso__d {
    color: var(--tinta-suave);
    font-size: 0.92rem;
    margin-bottom: 1.6rem;
  }

  .acceso__form {
    text-align: left;
  }

  .acceso__error {
    color: var(--rojo);
    font-size: 0.86rem;
    margin: 0.8rem 0 0;
    text-align: center;
  }

  .cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.8rem;
  }

  .cab__resumen {
    color: var(--tinta-suave);
    font-size: 0.9rem;
    margin: 0;
  }

  .aviso-api {
    border-left: 3px solid var(--rojo);
    padding-left: 0.9rem;
    color: var(--rojo);
    font-size: 0.9rem;
  }

  .filtros {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .filtros .campo {
    margin-bottom: 0;
    flex: 1 1 200px;
  }

  .filtros__limpiar {
    font-size: 0.8rem;
    color: var(--tinta-suave);
    border-bottom: 1px solid currentColor;
  }

  .vacio {
    color: var(--tinta-suave);
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .lista {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .pedido {
    background: #fff;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1rem 1.2rem;
  }

  .pedido__cab {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 1.2rem;
  }

  .pedido__numero {
    font-family: var(--titular);
    font-weight: 600;
    margin: 0;
  }

  .pedido__fecha {
    font-size: 0.78rem;
    color: var(--tinta-suave);
    margin: 0;
  }

  .pedido__total {
    font-family: var(--titular);
    font-size: 1.1rem;
    margin: 0;
  }

  .pedido__abrir {
    background: none;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 0.4rem 0.8rem;
    font-size: 0.78rem;
    color: var(--tinta-suave);
  }

  .pedido__abrir:hover {
    border-color: var(--salvia);
    color: var(--salvia);
  }

  .pedido__cliente {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }

  .pedido__cliente a:hover {
    color: var(--salvia);
  }

  .pedido__cuerpo {
    border-top: 1px solid var(--linea);
    margin-top: 1rem;
    padding-top: 1.2rem;
  }

  .etiqueta {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    border: 1px solid currentColor;
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .etiqueta--pendiente {
    color: var(--henna);
  }

  .etiqueta--pagado {
    color: var(--salvia);
  }

  .etiqueta--enviado {
    color: var(--jade);
  }

  .etiqueta--completado {
    color: var(--salvia-osc);
    background: var(--papel);
  }

  .etiqueta--cancelado {
    color: var(--rojo);
  }

  .aviso-demora {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--rojo);
  }

  .cab__alerta {
    color: var(--rojo);
  }

  .pista-manual {
    font-style: italic;
  }

  .cab__acciones {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Panel lateral de venta manual (mismo diseño que la ficha de productos) */
  .panel-lateral {
    position: fixed;
    inset: 0;
    z-index: 80;
  }

  .panel-lateral__velo {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--salvia-osc) 35%, transparent);
  }

  .panel-lateral__caja {
    position: absolute;
    top: 0;
    right: 0;
    width: min(560px, 100%);
    height: 100%;
    background: var(--fondo);
    display: flex;
    flex-direction: column;
    box-shadow: -18px 0 40px -30px var(--cafe-texto);
  }

  .ficha__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid var(--linea);
  }

  .ficha__cab h2 {
    font-size: 1.2rem;
  }

  .ficha__cab button {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: var(--tinta-suave);
  }

  .ficha__cuerpo {
    flex: 1;
    overflow-y: auto;
    padding: 1.4rem;
  }

  .ficha__pie {
    display: flex;
    gap: 0.8rem;
    justify-content: flex-end;
    padding: 1rem 1.4rem;
    border-top: 1px solid var(--linea);
    background: #fff;
  }

  .ficha__ayuda {
    font-size: 0.85rem;
    color: var(--tinta-suave);
    margin: 0 0 1.2rem;
  }

  .ficha__sub {
    font-size: 0.95rem;
    margin: 1.2rem 0 0.6rem;
  }

  .par {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1rem;
  }

  .linea-venta {
    display: grid;
    grid-template-columns: 1fr 4.5rem 6.5rem 1.6rem;
    gap: 0 0.6rem;
    align-items: end;
  }

  .linea-venta__quitar {
    background: none;
    border: none;
    color: var(--tinta-suave);
    padding-bottom: 1.1rem;
  }

  .venta-cuentas {
    margin-top: 1.2rem;
    align-items: end;
  }

  .venta-total {
    margin: 0 0 1rem;
  }

  .venta-total div {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .venta-total div:last-child {
    font-weight: 700;
  }

  .venta-total dd {
    margin: 0;
  }

  .casilla {
