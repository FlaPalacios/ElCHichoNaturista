---
import Base from '../layouts/Base.astro';
import FotoProducto from '../components/FotoProducto.astro';
import ApiCaida from '../components/ApiCaida.astro';
import { obtenerCategorias, obtenerProductos } from '../lib/api.js';

const { mostrarAgotado } = Astro.locals.tienda;

// Una vista rápida de todo lo que hay: foto y nombre, sin precios ni filtros.
// Va agrupada por categoría solo para que se recorra con la vista.
let lista = [];
let categorias = [];
let fallo = null;
try {
  [lista, categorias] = await Promise.all([obtenerProductos(), obtenerCategorias()]);
} catch (error) {
  fallo = error;
}

const secciones = categorias
  .map((c) => ({
    ...c,
    productos: lista
      .filter((p) => p.categoria === c.slug)
      .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es')),
  }))
  .filter((c) => c.productos.length > 0);
---

<Base
  title="Colección"
  description="Todos los productos de El Chico Naturista, de un vistazo."
  activo="coleccion"
>
  {fallo && <ApiCaida error={fallo} />}

  <header class="cab">
    <div class="env cab__env">
      <div>
        <p class="kicker">{lista.length} productos</p>
        <h1 class="titulo">Toda la colección</h1>
      </div>
      <p class="cab__nota">
        Todo lo que tenemos, de un vistazo. Toca un producto para ver su detalle y agregarlo.
      </p>
    </div>
  </header>

  <div class="env coleccion" hidden={Boolean(fallo)}>
    {
      secciones.map((c) => (
        <section class="seccion" id={c.slug}>
          <h2 class="seccion__t">
            {c.nombre}
            <span>{c.productos.length}</span>
          </h2>
          <ul class="tiles">
            {c.productos.map((p) => (
              <li>
                <a href={`/producto/${p.slug}`} class="tile" title={p.nombre}>
                  <span class="tile__foto">
                    <FotoProducto producto={p} sizes="(max-width: 700px) 48vw, (max-width: 1100px) 31vw, 290px" />
                    {mostrarAgotado && p.stock <= 0 && <span class="tile__agotado">Agotado</span>}
                  </span>
                  <span class="tile__nombre">{p.nombre}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      !fallo && secciones.length === 0 && (
        <p class="vacio">Todavía no hay productos para mostrar.</p>
      )
    }
  </div>
</Base>

<style>
  .cab {
    border-bottom: 1px solid var(--linea);
    background: var(--papel);
  }

  .cab__env {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.2rem, 4vw, 3.2rem);
  }

  .cab .kicker {
    margin-bottom: 0.6rem;
  }

  .cab__nota {
    max-width: 36ch;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin: 0;
    text-align: right;
  }

  .coleccion {
    padding-block: var(--e-6) var(--e-8);
  }

  .seccion + .seccion {
    margin-top: 4rem;
  }

  .seccion__t {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--linea-fuerte);
  }

  .seccion__t span {
    font-family: var(--texto);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--tinta-suave);
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.2rem 1.8rem;
  }

  .tile {
    display: block;
  }

  .tile__foto {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: var(--papel);
  }

  .tile__foto :global(.foto),
  .tile__foto :global(.sin-foto) {
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .tile:hover .tile__foto :global(.foto) {
    transform: scale(1.05);
  }

  .tile__agotado {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    padding: 0.18rem 0.45rem;
    border-radius: 3px;
    background: var(--cafe);
    color: #fff;
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.005em;
  }

  .tile__nombre {
    display: block;
    margin-top: 0.85rem;
    font-family: var(--display);
    font-size: 1.18rem;
    color: var(--cafe);
    font-weight: 600;
    line-height: 1.25;
    border-bottom: 1px solid transparent;
  }

  .tile:hover .tile__nombre {
    color: var(--salvia);
  }

  .vacio {
    text-align: center;
    color: var(--tinta-suave);
    padding: 3rem 0;
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem 1.4rem;
    }
  }

  @media (max-width: 760px) {
    .cab__env {
      flex-direction: column;
      align-items: flex-start;
    }
    .cab__nota {
      text-align: left;
    }
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem 0.9rem;
    }
  }
</style>
