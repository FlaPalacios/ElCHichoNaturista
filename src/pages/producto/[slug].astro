---
import Base from '../../layouts/Base.astro';
import FotoProducto from '../../components/FotoProducto.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import ApiCaida from '../../components/ApiCaida.astro';
import { obtenerProducto, obtenerProductos } from '../../lib/api.js';
import { urlCloudinary } from '../../lib/cloudinary.js';
import { waLink as enlaceWa } from '../../lib/tienda.js';

// SSR: la ficha se arma en cada visita, así el stock y el precio están al día.
const { slug } = Astro.params;

let producto = null;
let fallo = null;
try {
  producto = await obtenerProducto(slug);
} catch (error) {
  // La API está caída: eso no es un 404, es un problema nuestro.
  fallo = error;
}

// Producto inexistente, inactivo o borrado: 404 de verdad.
if (!fallo && !producto) {
  return Astro.rewrite('/404');
}

const cat = producto
  ? { slug: producto.categoria, nombre: producto.categoriaNombre }
  : { slug: '', nombre: '' };
const oferta = Boolean(producto?.precioAntes);
const dto = oferta ? Math.round((1 - producto.precio / producto.precioAntes) * 100) : 0;
const fotos = producto?.imagenes ?? [];
const waLink = (mensaje) => enlaceWa(Astro.locals.tienda, mensaje);

let relacionados = [];
if (producto) {
  try {
    relacionados = (await obtenerProductos({ categoria: producto.categoria }))
      .filter((p) => p.id !== producto.id)
      .slice(0, 3);
  } catch {
    relacionados = [];
  }
}

const paraCarrito = producto && {
  id: producto.id,
  slug: producto.slug,
  nombre: producto.nombre,
  precio: producto.precio,
  presentacion: producto.presentacion,
  categoria: producto.categoria,
  stock: producto.stock,
};

const consulta = producto
  ? waLink(`Hola, quiero consultar por "${producto.nombre}" (${producto.presentacion}).`)
  : '#';
---

<Base title={producto?.nombre ?? 'Producto'} description={producto?.descripcionCorta}>
  {fallo && <ApiCaida error={fallo} />}
  {!fallo && (
  <>
  <nav class="miga" aria-label="Ruta">
    <div class="env">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/catalogo">Catálogo</a>
      <span aria-hidden="true">/</span>
      <a href={`/catalogo?categoria=${cat.slug}`}>{cat.nombre}</a>
      <span aria-hidden="true">/</span>
      <em>{producto.nombre}</em>
    </div>
  </nav>

  <article class="env producto" x-data={`{ p: ${JSON.stringify(paraCarrito)}, cant: 1 }`}>
    <div class="producto__vista" x-data="{ activa: 0 }">
      <div class="producto__lamina">
        {
          fotos.length > 0 ? (
            fotos.map((foto, i) => (
              <img
                class="producto__foto"
                x-show={`activa === ${i}`}
                src={urlCloudinary(foto.url, 700)}
                srcset={[500, 700, 1000]
                  .map((w) => `${urlCloudinary(foto.url, w)} ${w}w`)
                  .join(', ')}
                sizes="(max-width: 900px) 92vw, 520px"
                alt={`${producto.nombre}${foto.tipo ? ` — ${foto.tipo}` : ''}`}
                width="700"
                height="840"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))
          ) : (
            <FotoProducto producto={producto} alto={true} />
          )
        }
        {oferta && <span class="producto__oferta">−{dto}%</span>}
      </div>

      {
        fotos.length > 1 && (
          <div class="miniaturas">
            {fotos.map((foto, i) => (
              <button
                type="button"
                class="miniaturas__btn"
                :class={`{ 'miniaturas__btn--activa': activa === ${i} }`}
                @click={`activa = ${i}`}
                aria-label={`Ver foto ${foto.tipo ?? i + 1}`}
              >
                <img src={urlCloudinary(foto.url, 160)} alt="" width="80" height="96" loading="lazy" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="producto__datos">
      <p class="producto__cat">
        <a href={`/catalogo?subcategoria=${producto.subcategoria}`}>
          {producto.subcategoriaNombre}
        </a>
        <span>·</span>
        <a href={`/catalogo?marca=${producto.marca}`}>{producto.marcaNombre}</a>
      </p>

      <h1 class="producto__nombre">{producto.nombre}</h1>
      <p class="producto__corta">{producto.descripcionCorta}</p>

      <div class="producto__precio">
        <p class="precio precio--grande">
          S/ {producto.precio.toFixed(2)}
          {oferta && <span class="precio-antes">S/ {producto.precioAntes.toFixed(2)}</span>}
        </p>
        <span class="producto__pres">{producto.presentacion}</span>
      </div>

      <p class="producto__stock">
        {
          // La cantidad exacta no se muestra al cliente: solo si hay o no.
          !mostrarAgotado || producto.stock > 0 ? (
            <><span class="punto punto--ok"></span> Disponible · sale hoy mismo en Lima</>
          ) : (
            <><span class="punto punto--poco"></span> Agotado por ahora</>
          )
        }
      </p>

      <div class="compra">
        <div class="paso paso--grande">
          <button @click="cant = Math.max(1, cant - 1)" aria-label="Menos uno">−</button>
          <span x-text="cant">1</span>
          <button @click={`cant = Math.min(${mostrarAgotado ? producto.stock : 99}, cant + 1)`} aria-label="Uno más">+</button>
        </div>
        <button class="btn compra__agregar" @click="$store.carrito.agregar(p, cant)" type="button">
          Agregar al carrito
        </button>
      </div>

      <a href={consulta} target="_blank" rel="noopener" class="btn btn--wa btn--bloque">
        Consultar por WhatsApp
      </a>

      <ul class="promesas">
        <li>Pago contra entrega o transferencia, coordinado por chat</li>
        <li>Envío gratis en Lima desde S/ 120</li>
        <li>A provincia por Shalom u Olva, previa coordinación</li>
      </ul>

      <section class="bloque">
        <h2 class="bloque__t">Qué es</h2>
        <p>{producto.descripcion}</p>
      </section>

      <section class="bloque">
        <h2 class="bloque__t">Por qué lo tenemos</h2>
        <ul class="beneficios">
          {producto.beneficios.map((b) => <li>{b}</li>)}
        </ul>
      </section>

      <section class="bloque bloque--uso">
        <h2 class="bloque__t">Cómo se usa</h2>
        <p>{producto.modoUso}</p>
      </section>

      <details class="detalle">
        <summary>Ficha corta</summary>
        <dl class="ficha-datos">
          <div><dt>Presentación</dt><dd>{producto.presentacion}</dd></div>
          <div><dt>Marca</dt><dd>{producto.marcaNombre}</dd></div>
          <div><dt>Categoría</dt><dd>{cat.nombre} · {producto.subcategoriaNombre}</dd></div>
          <div><dt>Código</dt><dd>{producto.codigo}</dd></div>
        </dl>
      </details>
    </div>
  </article>

  {
    relacionados.length > 0 && (
      <section class="seccion seccion--papel">
        <div class="env">
          <div class="cabecera-seccion">
            <div>
              <p class="kicker">Del mismo estante</p>
              <h2 class="titulo">También en {cat.nombre.toLowerCase()}</h2>
            </div>
            <a href={`/catalogo?categoria=${cat.slug}`} class="enlace-mas">
              Ver el departamento
            </a>
          </div>
          <div class="relacionados">
            {relacionados.map((p, i) => (
              <ProductoCard producto={p} indice={i + 1} />
            ))}
          </div>
        </div>
      </section>
    )
  }
  </>
  )}
</Base>

<style>
  .miga {
    border-bottom: 1px solid var(--linea);
    font-family: var(--titular);
    font-size: var(--t-sm);
    color: var(--tinta-suave);
  }

  .miga .env {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.9rem;
  }

  .miga a:hover {
    color: var(--salvia);
    text-decoration: underline;
  }

  .miga em {
    font-style: normal;
    color: var(--tinta);
  }

  .producto {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--e-6), 5vw, var(--e-8));
    padding-block: var(--e-7) var(--e-8);
    align-items: start;
  }

  .producto__vista {
    position: sticky;
    top: 120px;
  }

  .producto__lamina {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--linea);
    border-radius: var(--radio-foto);
    overflow: hidden;
    background: var(--papel);
  }

  .producto__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .producto__oferta {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border-radius: 3px;
    background: var(--henna);
    color: #fff;
    font-family: var(--titular);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.6rem;
  }

  .miniaturas {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .miniaturas__btn {
    width: 68px;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 1px solid var(--linea-fuerte);
    border-radius: 8px;
    overflow: hidden;
    background: var(--papel);
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }

  .miniaturas__btn:hover,
  .miniaturas__btn--activa {
    opacity: 1;
    border-color: var(--salvia);
  }

  .miniaturas__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .producto__cat {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--titular);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--tinta-suave);
    margin: 0 0 var(--e-4);
  }

  .producto__cat a:hover {
    color: var(--salvia);
  }

  .producto__nombre {
    font-size: var(--t-2xl);
    line-height: 1.05;
    margin-bottom: var(--e-4);
  }

  .producto__corta {
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--tinta-suave);
    max-width: 46ch;
    margin-bottom: var(--e-6);
  }

  .producto__precio {
    display: flex;
    align-items: baseline;
    gap: var(--e-4);
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    padding-block: var(--e-5);
  }

  /* El precio es el segundo punto focal después del nombre: misma serif. */
  .precio--grande {
    font-family: var(--display);
    font-size: clamp(2rem, 3vw, 2.4rem);
    font-weight: 600;
    margin: 0;
  }

  .producto__pres {
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin-left: auto;
  }

  .producto__stock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin: var(--e-4) 0 var(--e-5);
  }

  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .punto--ok {
    background: var(--salvia);
  }

  .punto--poco {
    background: var(--henna);
  }

  .compra {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  /* Cantidad: botones negros sólidos, igual que en el carrito lateral. */
  .paso--grande {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
  }

  .paso--grande button {
    display: grid;
    place-items: center;
    background: var(--cafe);
    border: none;
    border-radius: var(--radio);
    width: 44px;
    height: 48px;
    padding: 0;
    font-size: 1.25rem;
    line-height: 1;
    color: #fff;
    transition: background 0.2s;
  }

  .paso--grande button:hover:not([disabled]) {
    background: var(--cafe-hover);
  }

  .paso--grande button[disabled] {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .paso--grande span {
    min-width: 34px;
    text-align: center;
    font-family: var(--titular);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .compra__agregar {
    flex: 1;
  }

  .promesas {
    list-style: none;
    margin: var(--e-5) 0 var(--e-7);
    padding: 0;
    font-size: 0.92rem;
    color: var(--tinta-suave);
  }

  .promesas li {
    padding: 0.42rem 0 0.42rem 1.3rem;
    border-bottom: 1px solid var(--linea);
    position: relative;
  }

  .promesas li::before {
    content: '·';
    position: absolute;
    left: 0.3rem;
    color: var(--salvia);
    font-weight: 700;
  }

  .bloque {
    margin-bottom: var(--e-6);
  }

  .bloque__t {
    font-size: var(--t-sm);
    font-family: var(--titular);
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--salvia);
    margin-bottom: var(--e-3);
    padding-bottom: var(--e-2);
    border-bottom: 1px solid var(--linea);
  }

  .bloque p {
    margin: 0;
    color: var(--tinta-suave);
  }

  .bloque--uso {
    background: var(--papel);
    padding: var(--e-5);
    border-radius: 0 var(--radio) var(--radio) 0;
    border-left: 3px solid var(--salvia);
  }

  .bloque--uso .bloque__t {
    border-color: var(--linea-fuerte);
  }

  .beneficios {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .beneficios li {
    padding: 0.4rem 0 0.4rem 1.6rem;
    position: relative;
    color: var(--tinta-suave);
  }

  .beneficios li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--salvia);
    font-size: 0.9rem;
  }

  .detalle {
    border-top: 1px solid var(--linea);
    padding-top: var(--e-4);
  }

  .detalle summary {
    cursor: pointer;
    font-family: var(--titular);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--tinta-suave);
  }

  .ficha-datos {
    margin: 1rem 0 0;
  }

  .ficha-datos div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--linea);
    font-size: 0.9rem;
  }

  .ficha-datos dt {
    color: var(--tinta-suave);
  }

  .ficha-datos dd {
    margin: 0;
    text-align: right;
  }

  .relacionados {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--e-6);
  }

  @media (max-width: 900px) {
    .producto {
      grid-template-columns: 1fr;
    }
    .producto__vista {
      position: static;
    }
    .relacionados {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
