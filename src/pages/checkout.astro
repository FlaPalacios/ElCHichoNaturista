---
import Base from '../layouts/Base.astro';
// Los datos de la tienda los carga el middleware desde la API.
const tienda = Astro.locals.tienda;
import { obtenerDepartamentos } from '../lib/api.js';

// Los departamentos se renderizan desde el servidor; provincias y distritos
// los pide el navegador al ir eligiendo.
let departamentos = [];
try {
  departamentos = await obtenerDepartamentos();
} catch {
  departamentos = [];
}
---

<Base title="Finalizar pedido" description="Genera tu número de pedido y confírmalo por WhatsApp." activo="checkout">
  <header class="cab">
    <div class="env cab__env">
      <div>
        <p class="kicker">Paso 2 de 2</p>
        <h1 class="titulo">Finalizar pedido</h1>
      </div>
      <p class="cab__nota">
        No se cobra nada en línea. Generamos tu número de pedido y lo confirmas por WhatsApp.
      </p>
    </div>
  </header>

  <div
    class="env checkout"
    x-cloak
    x-data={`checkout(${JSON.stringify(departamentos)})`}
  >
    <!-- ── Carrito vacío ───────────────────────────────────────── -->
    <section class="aviso-vacio" x-show="!hecho && $store.carrito.vacio">
      <p class="aviso-vacio__t">No hay nada que confirmar</p>
      <p>Tu carrito está vacío. Agrega productos y vuelve a este paso.</p>
      <a href="/catalogo" class="btn">Ir al catálogo</a>
    </section>

    <!-- ── Confirmación ────────────────────────────────────────── -->
    <section class="listo" x-show="hecho">
      <p class="kicker">Pedido generado</p>
      <p class="listo__numero" x-text="hecho?.numero"></p>
      <h2 class="listo__t">Falta un paso: envíanos el mensaje</h2>
      <p class="listo__d">
        Abrimos WhatsApp con el detalle ya escrito. Si no se abrió solo, usa el botón. Tu pedido
        queda reservado cuando recibimos ese mensaje.
      </p>

      <div class="listo__acciones">
        <a :href="enlaceWa" target="_blank" rel="noopener" class="btn btn--wa">Enviar pedido por WhatsApp</a>
        <a href="/catalogo" class="btn btn--linea">Seguir comprando</a>
      </div>

      <div class="listo__detalle">
        <h3>Detalle</h3>
        <ul>
          <template x-for="i in hecho?.items || []" :key="i.producto_id">
            <li>
              <span x-text="i.cantidad + ' × ' + i.nombre"></span>
              <span x-text="$store.carrito.soles(i.precio_unitario * i.cantidad)"></span>
            </li>
          </template>
        </ul>
        <p class="listo__total">
          <span>Total</span>
          <strong x-text="$store.carrito.soles(hecho?.total || 0)"></strong>
        </p>
        <p class="listo__nota">
          Guarda tu número de pedido. Lo usamos para ubicar tu compra en el chat.
        </p>
        <p class="listo__sync" x-show="hecho && !hecho.sincronizado" x-cloak>
          Guardamos tu pedido en este dispositivo; en cuanto tengamos conexión con nuestro
          sistema lo confirmamos. Igual coordina el pago y la entrega por WhatsApp.
        </p>
      </div>
    </section>

    <!-- ── Formulario ──────────────────────────────────────────── -->
    <form class="checkout__cuerpo" x-show="!hecho && !$store.carrito.vacio" @submit.prevent="confirmar()">
      <div class="formulario">
        <fieldset class="bloque-form">
          <legend><span class="indice">01</span> Tus datos</legend>

          <label class="campo">
            <span class="campo__etq">Nombre completo</span>
            <input type="text" x-model="datos.nombre" autocomplete="name" placeholder="Nombre y apellido" />
            <span class="error" x-show="intento && errores.nombre" x-text="errores.nombre"></span>
          </label>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">WhatsApp</span>
              <input type="tel" x-model="datos.telefono" autocomplete="tel" placeholder="9XX XXX XXX" />
              <span class="error" x-show="intento && errores.telefono" x-text="errores.telefono"></span>
            </label>

            <label class="campo">
              <span class="campo__etq">Correo (opcional)</span>
              <input type="email" x-model="datos.correo" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
              <span class="error" x-show="intento && errores.correo" x-text="errores.correo"></span>
            </label>
          </div>
        </fieldset>

        <fieldset class="bloque-form">
          <legend><span class="indice">02</span> A dónde lo enviamos</legend>

          <label class="campo">
            <span class="campo__etq">Dirección</span>
            <input type="text" x-model="datos.direccion" autocomplete="street-address" placeholder="Calle, número y departamento" />
            <span class="error" x-show="intento && errores.direccion" x-text="errores.direccion"></span>
          </label>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">Departamento</span>
              <select x-model="datos.departamento" @change="cambiarDepartamento()">
                <option value="">Elige tu departamento</option>
                {departamentos.map((d) => <option value={d.codigo}>{d.nombre}</option>)}
              </select>
              <span class="error" x-show="intento && errores.departamento" x-text="errores.departamento"></span>
            </label>

            <label class="campo">
              <span class="campo__etq">Provincia</span>
              <select x-model="datos.provincia" @change="cambiarProvincia()" :disabled="!datos.departamento || cargando === 'provincias'">
                <option value="" x-text="cargando === 'provincias' ? 'Cargando…' : 'Elige tu provincia'"></option>
                <template x-for="pr in provincias" :key="pr.codigo">
                  <option :value="pr.codigo" x-text="pr.nombre"></option>
                </template>
              </select>
              <span class="error" x-show="intento && errores.provincia" x-text="errores.provincia"></span>
            </label>
          </div>

          <div class="par">
            <label class="campo">
              <span class="campo__etq">Distrito</span>
              <select x-model="datos.distrito" @change="cambiarDistrito()" :disabled="!datos.provincia || cargando === 'distritos'">
                <option value="" x-text="cargando === 'distritos' ? 'Cargando…' : 'Elige tu distrito'"></option>
                <template x-for="di in distritos" :key="di.codigo">
                  <option :value="di.codigo" x-text="di.nombre"></option>
                </template>
              </select>
              <span class="error" x-show="intento && errores.distrito" x-text="errores.distrito"></span>
            </label>

            <label class="campo">
              <span class="campo__etq">Referencia (opcional)</span>
              <input type="text" x-model="datos.referencia" placeholder="Portón verde, frente al parque" />
            </label>
          </div>

          <p class="apunte">
            Envío gratis en todo el Perú desde S/ {tienda.envioGratisDesde}.
          </p>
        </fieldset>

        <fieldset class="bloque-form">
          <legend><span class="indice">03</span> Algo más que debamos saber</legend>

          <label class="campo">
            <span class="campo__etq">Nota para el pedido (opcional)</span>
            <textarea x-model="datos.nota" rows="3" placeholder="Ej.: entregar después de las 5 p. m."></textarea>
          </label>

          <p class="apunte apunte--pago">
            El pago lo coordinamos por WhatsApp: puedes cancelar con <strong>Yape</strong>,
            <strong>Plin</strong> o <strong>transferencia bancaria</strong>. No se cobra nada
            en línea.
          </p>
        </fieldset>
      </div>

      <aside class="resumen">
        <h2 class="resumen__t">Tu pedido</h2>

        <ul class="resumen__lista">
          <template x-for="item in $store.carrito.items" :key="item.id">
            <li>
              <span class="resumen__nombre">
                <span x-text="item.cantidad"></span> × <span x-text="item.nombre"></span>
              </span>
              <span x-text="$store.carrito.soles(item.precio * item.cantidad)"></span>
            </li>
          </template>
        </ul>

        <dl class="cuentas">
          <div>
            <dt>Subtotal</dt>
            <dd x-text="$store.carrito.soles($store.carrito.subtotal)"></dd>
          </div>
          <div>
            <dt>Envío</dt>
            <dd
              x-text="costoEnvio === 0 ? 'Gratis' : (costoEnvio === null ? (cargando === 'envio' ? 'Calculando…' : 'Elige tu distrito') : $store.carrito.soles(costoEnvio))"
            ></dd>
          </div>
          <div class="cuentas__total">
            <dt>Total</dt>
            <dd x-text="$store.carrito.soles(total)"></dd>
          </div>
        </dl>

        <button type="submit" class="btn btn--bloque" :disabled="enviando">
          <span x-text="enviando ? 'Generando pedido…' : 'Generar pedido y abrir WhatsApp'"></span>
        </button>

        <p class="error error--bloque" x-show="intento && !valido">
          Revisa los campos marcados antes de continuar.
        </p>

        <p class="resumen__nota">
          Al confirmar se abre WhatsApp con el detalle escrito. Ahí acordamos el pago y el
          horario de entrega.
        </p>

        <a href="/carrito" class="resumen__volver">← Volver al carrito</a>
      </aside>
    </form>
  </div>
</Base>

<style>
  .cab {
    border-bottom: 1px solid var(--linea);
    background: var(--papel);
  }

  .cab__env {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.2rem, 4vw, 3.2rem);
  }

  .cab .kicker {
    margin-bottom: 0.6rem;
  }

  .cab__nota {
    max-width: 36ch;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin: 0;
    text-align: right;
  }

  .checkout {
    padding-block: 3rem 4rem;
  }

  .checkout__cuerpo {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: start;
  }

  /* Formulario */
  .bloque-form {
    border: none;
    border-top: 1px solid var(--linea-fuerte);
    margin: 0 0 2.2rem;
    padding: 1.4rem 0 0;
  }

  .bloque-form legend {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0;
    font-family: var(--titular);
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
  }

  .par {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.2rem;
  }

  .error {
    display: block;
    font-size: 0.76rem;
    color: var(--henna);
    margin-top: 0.3rem;
  }

  /* Dentro del resumen (fondo jade) el henna casi no contrasta. */
  .resumen .error {
    color: var(--cafe);
  }

  .error--bloque {
    text-align: center;
    margin-top: 0.7rem;
  }

  .apunte {
    font-size: 0.86rem;
    color: var(--tinta-suave);
    border-left: 3px solid var(--jade);
    padding-left: 0.9rem;
    margin: 0;
  }

  .apunte--pago {
    border-left-color: var(--henna);
    margin-top: 1.1rem;
  }

  /* Resumen */
  .resumen {
    position: sticky;
    top: 120px;
    background: var(--jade);
    color: var(--cafe-texto);
    border: 1px solid var(--cafe-linea);
    padding: 1.5rem;
  }

  .resumen__t {
    font-size: 1.3rem;
    color: var(--cafe);
    margin-bottom: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--cafe-linea);
  }

  .resumen__lista {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    font-size: 0.88rem;
  }

  .resumen__lista li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px dotted var(--cafe-linea);
  }

  .resumen__nombre {
    color: var(--cafe-suave);
  }

  .cuentas {
    margin: 0 0 1.2rem;
  }

  .cuentas div {
    display: flex;
    justify-content: space-between;
    font-size: 0.92rem;
    padding: 0.28rem 0;
  }

  .cuentas dt,
  .cuentas dd {
    margin: 0;
  }

  .cuentas__total {
    border-top: 1px solid var(--cafe-linea);
    margin-top: 0.6rem;
    padding-top: 0.7rem !important;
    font-family: var(--titular);
    font-size: 1.3rem !important;
    font-weight: 600;
    color: var(--cafe);
  }

  .resumen__nota {
    font-size: 0.78rem;
    color: var(--cafe-suave);
    margin: 0.9rem 0 0;
  }

  .resumen__volver {
    display: block;
    margin-top: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cafe-suave);
  }

  .resumen__volver:hover {
    color: var(--cafe);
  }

  /* Confirmación */
  .listo {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
    padding-block: 1rem 2rem;
  }

  .listo__numero {
    font-family: var(--titular);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--salvia);
    margin: 0.6rem 0 1.2rem;
    padding-block: 0.8rem;
    border-top: 2px solid var(--salvia);
    border-bottom: 2px solid var(--salvia);
  }

  .listo__t {
    font-size: 1.6rem;
    margin-bottom: 0.7rem;
  }

  .listo__d {
    color: var(--tinta-suave);
    max-width: 46ch;
    margin-inline: auto;
  }

  .listo__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.6rem 0 2.5rem;
  }

  .listo__detalle {
    text-align: left;
    background: var(--jade);
    color: var(--cafe-texto);
    border: 1px solid var(--cafe-linea);
    padding: 1.4rem 1.5rem;
  }

  .listo__detalle h3 {
    font-size: 0.72rem;
    font-family: var(--texto);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--salvia-osc);
    margin-bottom: 0.8rem;
  }

  .listo__detalle ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .listo__detalle li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px dotted var(--cafe-linea);
  }

  .listo__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0.9rem 0 0;
    font-family: var(--titular);
    font-size: 1.2rem;
    color: var(--cafe);
  }

  .listo__nota {
    font-size: 0.78rem;
    color: var(--cafe-suave);
    margin: 0.8rem 0 0;
  }

  .listo__sync {
    font-size: 0.78rem;
    color: var(--cafe-suave);
    border-left: 3px solid var(--henna);
    padding-left: 0.9rem;
    margin: 0.9rem 0 0;
  }

  /* Vacío */
  .aviso-vacio {
    text-align: center;
    padding-block: 3rem 2rem;
  }

  .aviso-vacio__t {
    font-family: var(--titular);
    font-size: 1.8rem;
    margin-bottom: 0.3rem;
  }

  .aviso-vacio p {
    color: var(--tinta-suave);
  }

  @media (max-width: 900px) {
    .checkout__cuerpo {
      grid-template-columns: 1fr;
    }
    .resumen {
      position: static;
    }
    .cab__env {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .cab__nota {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .par {
      grid-template-columns: 1fr;
    }
  }
</style>
