---
import Base from '../layouts/Base.astro';
import { waLink as enlaceWa } from '../lib/tienda.js';

// Los datos de la tienda los carga el middleware desde la API.
const tienda = Astro.locals.tienda;
const waLink = (mensaje) => enlaceWa(tienda, mensaje);
---

<Base title="Mis pedidos" description="Consulta el estado de tu pedido con su número." activo="cuenta">
  <header class="cab">
    <div class="env cab__env">
      <div>
        <p class="kicker">Seguimiento</p>
        <h1 class="titulo">Mis pedidos</h1>
      </div>
      <p class="cab__nota">
No hace falta crear una cuenta. Con el número de tu pedido puedes ver en qué va.
      </p>
    </div>
  </header>

  <div class="env cuenta">
    <section class="acceso" x-data="consultaPedido">
      <h2 class="acceso__t">Consulta tu pedido</h2>
      <p class="acceso__d">
        Escribe el número que te dimos al confirmar (por ejemplo ECN-260921-4471) y te decimos
        en qué va.
      </p>

      <form class="acceso__form" @submit.prevent="buscar()">
        <label class="campo">
          <span class="campo__etq">Número de pedido</span>
          <input type="text" x-model="numero" placeholder="ECN-AAMMDD-NNNN" autocomplete="off" />
        </label>
        <button class="btn btn--bloque" type="submit" :disabled="buscando">
          <span x-text="buscando ? 'Buscando…' : 'Consultar'"></span>
        </button>
        <p class="error" x-show="error" x-text="error"></p>
      </form>

      <div class="hallado" x-show="pedido" x-cloak>
        <p class="hallado__numero" x-text="pedido?.numero"></p>
        <p class="hallado__estado" x-text="$store.pedido.etiquetaEstado(pedido?.estado)"></p>
        <ul class="hallado__items">
          <template x-for="i in pedido?.items || []" :key="i.producto_id">
            <li>
              <span x-text="i.cantidad + ' × ' + i.nombre"></span>
              <span x-text="$store.carrito.soles(i.precio_unitario * i.cantidad)"></span>
            </li>
          </template>
        </ul>
        <p class="hallado__total">
          <span>Total</span>
          <strong x-text="$store.carrito.soles(pedido?.total || 0)"></strong>
        </p>
        <p class="acceso__aviso">
          ¿Algo no cuadra? Escríbenos por WhatsApp al {tienda.whatsappVisible} con tu número de
          pedido.
        </p>
      </div>
    </section>

    <aside class="lateral" x-cloak>
      <section class="ultimo" x-show="$store.pedido.ultimo">
        <p class="kicker">Tu último pedido</p>
        <p class="ultimo__numero" x-text="$store.pedido.ultimo?.numero"></p>
        <p class="ultimo__fecha">
          <span x-text="$store.pedido.ultimo ? new Date($store.pedido.ultimo.fecha).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' }) : ''"></span>
          · <span class="ultimo__estado" x-text="$store.pedido.etiquetaEstado($store.pedido.ultimo?.estado)"></span>
          <span
            class="ultimo__pendiente"
            x-show="$store.pedido.ultimo?.sincronizado === false"
            title="Todavía no lo confirmamos con nuestro sistema"
          >· guardado en este dispositivo</span>
        </p>

        <ul class="ultimo__items">
          <template x-for="i in $store.pedido.ultimo?.items || []" :key="i.producto_id">
            <li>
              <span x-text="i.cantidad + ' × ' + i.nombre"></span>
              <span x-text="$store.carrito.soles(i.precio_unitario * i.cantidad)"></span>
            </li>
          </template>
        </ul>

        <p class="ultimo__total">
          <span>Total</span>
          <strong x-text="$store.carrito.soles($store.pedido.ultimo?.total || 0)"></strong>
        </p>

        <a
          :href="$store.pedido.ultimo ? $store.pedido.mensajeWhatsApp($store.pedido.ultimo) : '#'"
          target="_blank"
          rel="noopener"
          class="btn btn--wa btn--bloque"
        >Consultar este pedido</a>
      </section>

      <section class="ultimo ultimo--vacio" x-show="!$store.pedido.ultimo">
        <p class="kicker">Historial</p>
        <p class="ultimo__nada">
          Todavía no hay pedidos en este navegador. Cuando confirmes uno, aparecerá acá con su
          número para hacerle seguimiento.
        </p>
        <a href="/catalogo" class="btn btn--claro btn--bloque">Ver catálogo</a>
      </section>

      <section class="ayuda">
        <p class="kicker">¿Prefieres no registrarte?</p>
        <p>
          Escríbenos y armamos el pedido contigo por el chat. Atendemos {tienda.horario.toLowerCase()}.
        </p>
        <a href={waLink('Hola, quiero hacer un pedido por el chat.')} target="_blank" rel="noopener" class="enlace-mas">
          Escribir al {tienda.whatsappVisible}
        </a>
      </section>
    </aside>
  </div>
</Base>

<style>
  .cab {
    border-bottom: 1px solid var(--linea);
    background: var(--papel);
  }

  .cab__env {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.2rem, 4vw, 3.2rem);
  }

  .cab .kicker {
    margin-bottom: 0.6rem;
  }

  .cab__nota {
    max-width: 36ch;
    font-size: 0.86rem;
    color: var(--tinta-suave);
    margin: 0;
    text-align: right;
  }

  .cuenta {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    padding-block: 3rem 4rem;
    align-items: start;
  }

  .acceso {
    max-width: 520px;
  }

  .acceso__t {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .acceso__d {
    color: var(--tinta-suave);
    font-size: 0.93rem;
    margin-bottom: 1.4rem;
  }

  .hallado {
    border-top: 1px solid var(--linea-fuerte);
    margin-top: 1.6rem;
    padding-top: 1.3rem;
  }

  .hallado__numero {
    font-family: var(--titular);
    font-size: 1.3rem;
    color: var(--cafe);
    margin: 0;
  }

  .hallado__estado {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--salvia);
    margin: 0.2rem 0 1rem;
  }

  .hallado__items {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }

  .hallado__items li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px dotted var(--linea-fuerte);
  }

  .hallado__total {
    display: flex;
    justify-content: space-between;
    margin: 0.9rem 0 0;
    font-family: var(--titular);
    font-size: 1.1rem;
  }

  .acceso__aviso {
    font-size: 0.8rem;
    color: var(--tinta-suave);
    border-left: 3px solid var(--jade);
    padding-left: 0.9rem;
    margin: 1.2rem 0 0;
  }

  .lateral {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ultimo {
    background: var(--jade);
    color: var(--cafe-texto);
    border: 1px solid var(--cafe-linea);
    padding: 1.4rem 1.5rem;
  }

  .ultimo .kicker {
    color: var(--salvia-osc);
  }

  .ultimo__numero {
    font-family: var(--titular);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--cafe);
    margin: 0.5rem 0 0.2rem;
  }

  .ultimo__fecha {
    font-size: 0.8rem;
    color: var(--cafe-suave);
    margin-bottom: 1rem;
  }

  .ultimo__estado {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cafe);
  }

  .ultimo__pendiente {
    font-size: 0.7rem;
    color: var(--cafe-suave);
  }

  .ultimo__items {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0;
    font-size: 0.86rem;
  }

  .ultimo__items li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px dotted var(--cafe-linea);
  }

  .ultimo__total {
    display: flex;
    justify-content: space-between;
    font-family: var(--titular);
    font-size: 1.1rem;
    color: var(--cafe);
    margin-bottom: 1.1rem;
  }

  .ultimo__nada {
    font-size: 0.9rem;
    color: var(--cafe-suave);
    margin-block: 0.8rem 1.2rem;
  }

  .ayuda {
    border-top: 2px solid var(--salvia);
    padding-top: 1.2rem;
  }

  .ayuda p {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    margin-block: 0.8rem;
  }

  @media (max-width: 900px) {
    .cuenta {
      grid-template-columns: 1fr;
    }
    .cab__env {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .cab__nota {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .par {
      grid-template-columns: 1fr;
    }
  }
</style>
