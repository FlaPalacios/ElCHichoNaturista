---
// Divisor con la greca del sello. Decorativo.
const { color = 'var(--jade)', class: clase = '' } = Astro.props;
---

<svg class:list={['greca', clase]} height="10" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="greca-p" width="24" height="10" patternUnits="userSpaceOnUse">
      <path d="M0 9 L6 1 L12 9 L18 1 L24 9" fill="none" stroke={color} stroke-width="1.4" />
    </pattern>
  </defs>
  <rect width="100%" height="10" fill="url(#greca-p)" />
</svg>

<style>
  .greca {
    display: block;
    width: 100%;
    opacity: 0.7;
  }
</style>
